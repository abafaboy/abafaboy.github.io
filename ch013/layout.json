 "lines": [
  {
   "i": 1,
   "who": "gc_manager",
   "type": "speech",
   "text": "NINE O'CLOCK, MR. DOKGO.",
   "panel_id": "P01",
   "y_top": 26,
   "y_bottom": 180,
   "segment": "001.webp",
   "seg_y": 180
  },
  {
   "i": 2,
   "who": "offpanel:gc_manager",
   "type": "phone",
   "text": "SEVEN HOURS. FOUR HUNDRED AND TWENTY MINUTES.",
   "panel_id": "P02",
   "y_top": 1855,
   "y_bottom": 2065,
   "segment": "001.webp",
   "seg_y": 2065
  },
  {
   "i": 3,
   "who": "offpanel:gc_manager",
   "type": "phone",
   "text": "I'M COUNTING EVERY MINUTE.",
   "panel_id": "P02",
   "y_top": 2083,
   "y_bottom": 2249,
   "segment": "001.webp",
   "seg_y": 2249
  },
  {
   "i": 4,
   "who": "dokgo",
   "type": "speech",
   "text": "YES, SIR. ON SCHEDULE, SIR.",
   "panel_id": "P02",
   "y_top": 2801,
   "y_bottom": 2955,
   "segment": "001.webp",
   "seg_y": 2955
  },
  {
   "i": 5,
   "who": "dokgo",
   "type": "speech",
   "text": "SEVEN HOURS TO HAND THE SITE BACK, PEOPLE.",
   "panel_id": "P04",
   "y_top": 3771,
   "y_bottom": 3993,
   "segment": "002.webp",
   "seg_y": 932
  },
  {
   "i": 6,
   "who": "dokgo",
   "type": "speech",
   "text": "THE GENERAL CONTRACTOR IS COUNTING EVERY MINUTE.",
   "panel_id": "P04",
   "y_top": 4011,
   "y_bottom": 4300,
   "segment": "002.webp",
   "seg_y": 1239
  },
  {
   "i": 7,
   "who": "taeo",
   "type": "float",
   "text": "C-GRADE. I LOOKED IT UP LAST NIGHT.",
   "panel_id": "P06",
   "y_top": 7109,
   "y_bottom": 7197,
   "segment": "003.webp",
   "seg_y": 1934
  },
  {
   "i": 8,
   "who": "taeo",
   "type": "float",
   "text": "I SHOULDN'T HAVE.",
   "panel_id": "P06",
   "y_top": 7215,
   "y_bottom": 7264,
   "segment": "003.webp",
   "seg_y": 2001
  },
  {
   "i": 9,
   "who": "minho",
   "type": "speech",
   "text": "SITE RULES. HARD HAT.",
   "panel_id": "P07",
   "y_top": 8110,
   "y_bottom": 8264,
   "segment": "004.webp",
   "seg_y": 264
  },
  {
   "i": 10,
   "who": "nib",
   "type": "speech",
   "text": "IT'S SITTING ON MY EARS.",
   "panel_id": "P07",
   "y_top": 8282,
   "y_bottom": 8436,
   "segment": "004.webp",
   "seg_y": 436
  },
  {
   "i": 11,
   "who": "haein",
   "type": "speech",
   "text": "GIVE IT HERE.",
   "panel_id": "P08",
   "y_top": 9355,
   "y_bottom": 9509,
   "segment": "004.webp",
   "seg_y": 1509
  },
  {
   "i": 12,
   "who": "nib",
   "type": "speech",
   "text": "BETTER.",
   "panel_id": "P09",
   "y_top": 10041,
   "y_bottom": 10128,
   "segment": "004.webp",
   "seg_y": 2128
  },
  {
   "i": 13,
   "who": "offpanel:minho",
   "type": "speech",
   "text": "AND BOOTS?",
   "panel_id": "P09",
   "y_top": 10150,
   "y_bottom": 10242,
   "segment": "004.webp",
   "seg_y": 2242
  },
  {
   "i": 14,
   "who": "nib",
   "type": "speech",
   "text": "NO.",
   "panel_id": "P09",
   "y_top": 10264,
   "y_bottom": 10350,
   "segment": "004.webp",
   "seg_y": 2350
  },
  {
   "i": 15,
   "who": "haein",
   "type": "speech",
   "text": "THE CABLE CARRIES RADIO SIGNALS THROUGH THE GATE. KEEP THE CABLE INTACT.",
   "panel_id": "P10",
   "y_top": 10686,
   "y_bottom": 10974,
   "segment": "005.webp",
   "seg_y": 398
  },
  {
   "i": 16,
   "who": "minho",
   "type": "speech",
   "text": "TAEO, LOG NIB'S CALLS. AND YOU **STAY** OUTSIDE.",
   "panel_id": "P10",
   "y_top": 10992,
   "y_bottom": 11214,
   "segment": "005.webp",
   "seg_y": 638
  },
  {
   "i": 17,
   "who": "taeo",
   "type": "speech",
   "text": "YOU'VE SAID THAT TWICE.",
   "panel_id": "P10",
   "y_top": 11747,
   "y_bottom": 11900,
   "segment": "005.webp",
   "seg_y": 1324
  },
  {
   "i": 18,
   "who": "minho",
   "type": "speech",
   "text": "I'LL SAY IT AGAIN AT TEN.",
   "panel_id": "P11",
   "y_top": 12032,
   "y_bottom": 12254,
   "segment": "005.webp",
   "seg_y": 1678
  },
  {
   "i": 19,
   "who": "dokgo",
   "type": "speech",
   "text": "YOUR SCOUT GOES IN AT TEN. NOT TEN-OH-ONE.",
   "panel_id": "P11",
   "y_top": 12125,
   "y_bottom": 12346,
   "segment": "005.webp",
   "seg_y": 1770
  },
  {
   "i": 20,
   "who": "minho",
   "type": "speech",
   "text": "NIB GOES IN WHEN THE FRAME'S CHECKED.",
   "panel_id": "P11",
   "y_top": 12871,
   "y_bottom": 13048,
   "segment": "005.webp",
   "seg_y": 2472
  },
  {
   "i": 21,
   "who": "offpanel:dokgo",
   "type": "speech",
   "text": "CLAUSE NINE. READ IT.",
   "panel_id": "P12",
   "y_top": 13180,
   "y_bottom": 13401,
   "segment": "006.webp",
   "seg_y": 281
  },
  {
   "i": 22,
   "who": "taeo",
   "type": "speech",
   "text": "FIVE MILLION WON. AN HOUR?",
   "panel_id": "P13",
   "y_top": 13803,
   "y_bottom": 13957,
   "segment": "006.webp",
   "seg_y": 837
  },
  {
   "i": 23,
   "who": "dokgo",
   "type": "speech",
   "text": "THE GENERAL CONTRACTOR CHARGES ME FOR DELAYS.",
   "panel_id": "P13",
   "y_top": 13975,
   "y_bottom": 14264,
   "segment": "006.webp",
   "seg_y": 1144
  },
  {
   "i": 24,
   "who": "dokgo",
   "type": "speech",
   "text": "I PASS THE COST TO MY WORKERS.",
   "panel_id": "P13",
   "y_top": 14792,
   "y_bottom": 14946,
   "segment": "006.webp",
   "seg_y": 1826
  },
  {
   "i": 25,
   "who": "taeo",
   "type": "float",
   "text": "FIVE MILLION AN HOUR IS ₩83,333 A MINUTE.",
   "panel_id": "P14",
   "y_top": 15388,
   "y_bottom": 15476,
   "segment": "006.webp",
   "seg_y": 2356
  },
  {
   "i": 26,
   "who": "dami",
   "type": "speech",
   "text": "YOU'RE STARING.",
   "panel_id": "P16",
   "y_top": 17022,
   "y_bottom": 17176,
   "segment": "007.webp",
   "seg_y": 984
  },
  {
   "i": 27,
   "who": "taeo",
   "type": "nervous",
   "text": "SORRY. I THINK I SAW YOU ON THE NEWS.",
   "panel_id": "P16",
   "y_top": 17086,
   "y_bottom": 17301,
   "segment": "007.webp",
   "seg_y": 1109
  },
  {
   "i": 28,
   "who": "dami",
   "type": "speech",
   "text": "THE BACK OF ME. THEY FILMED THE HUNTERS.",
   "panel_id": "P16",
   "y_top": 17812,
   "y_bottom": 18034,
   "segment": "007.webp",
   "seg_y": 1842
  },
  {
   "i": 29,
   "who": "dami",
   "type": "whisper",
   "text": "DOKGO TOLD THE NEWS THE MISSING PORTER 'LEFT VOLUNTARILY'.",
   "panel_id": "P17",
   "y_top": 18140,
   "y_bottom": 18442,
   "segment": "007.webp",
   "seg_y": 2250
  },
  {
   "i": 30,
   "who": "offpanel:taeo",
   "type": "speech",
   "text": "THEN WHY DO YOU STILL WORK FOR DOKGO?",
   "panel_id": "P17",
   "y_top": 18464,
   "y_bottom": 18753,
   "segment": "007.webp",
   "seg_y": 2561
  },
  {
   "i": 31,
   "who": "offpanel:dami",
   "type": "speech",
   "text": "I STILL OWE BLUEBIRD. I NEED THE WORK.",
   "panel_id": "P18",
   "y_top": 19106,
   "y_bottom": 19328,
   "segment": "008.webp",
   "seg_y": 491
  },
  {
   "i": 32,
   "who": "dami",
   "type": "speech",
   "text": "TOOK A DRAW LOAN AT EIGHTEEN. GOT TWO COMMON CONSTRUCTS.",
   "panel_id": "P19",
   "y_top": 19744,
   "y_bottom": 19966,
   "segment": "008.webp",
   "seg_y": 1129
  },
  {
   "i": 33,
   "who": "dami",
   "type": "speech",
   "text": "I LEASE THEM TO A WAREHOUSE. THIRTY THOUSAND WON EACH, EVERY MONTH.",
   "panel_id": "P19",
   "y_top": 19984,
   "y_bottom": 20273,
   "segment": "008.webp",
   "seg_y": 1436
  },
  {
   "i": 34,
   "who": "dami",
   "type": "speech",
   "text": "THE INTEREST PULLED BETTER THAN I DID.",
   "panel_id": "P19",
   "y_top": 20777,
   "y_bottom": 20998,
   "segment": "008.webp",
   "seg_y": 2161
  },
  {
   "i": 35,
   "who": "dami",
   "type": "speech",
   "text": "ARE YOU LOOKING AT MY POCKETS?",
   "panel_id": "P20",
   "y_top": 21130,
   "y_bottom": 21352,
   "segment": "009.webp",
   "seg_y": 283
  },
  {
   "i": 36,
   "who": "nib",
   "type": "speech",
   "text": "FOURTEEN POCKETS.",
   "panel_id": "P20",
   "y_top": 21370,
   "y_bottom": 21524,
   "segment": "009.webp",
   "seg_y": 455
  },
  {
   "i": 37,
   "who": "dami",
   "type": "speech",
   "text": "SIXTEEN. TWO INSIDE.",
   "panel_id": "P20",
   "y_top": 22110,
   "y_bottom": 22332,
   "segment": "009.webp",
   "seg_y": 1263
  },
  {
   "i": 38,
   "who": "dami",
   "type": "speech",
   "text": "WHAT ARE THEY PAYING YOU?",
   "panel_id": "P21",
   "y_top": 22464,
   "y_bottom": 22618,
   "segment": "009.webp",
   "seg_y": 1549
  },
  {
   "i": 39,
   "who": "nib",
   "type": "speech",
   "text": "SIXTY THOUSAND WON A DAY.",
   "panel_id": "P21",
   "y_top": 22528,
   "y_bottom": 22682,
   "segment": "009.webp",
   "seg_y": 1613
  },
  {
   "i": 40,
   "who": "dami",
   "type": "speech",
   "text": "THEY GOT YOU CHEAPER THAN ME.",
   "panel_id": "P21",
   "y_top": 23215,
   "y_bottom": 23437,
   "segment": "009.webp",
   "seg_y": 2368
  },
  {
   "i": 41,
   "who": "dami",
   "type": "speech",
   "text": "NINETY THOUSAND A DAY. NO INSURANCE. WHAT DO YOU GET?",
   "panel_id": "P22",
   "y_top": 23543,
   "y_bottom": 23965,
   "segment": "009.webp",
   "seg_y": 2896
  },
  {
   "i": 42,
   "who": "offpanel:taeo",
   "type": "speech",
   "text": "NOTHING. I STAY OUTSIDE.",
   "panel_id": "P22",
   "y_top": 23987,
   "y_bottom": 24209,
   "segment": "009.webp",
   "seg_y": 3140
  },
  {
   "i": 43,
   "who": "offpanel:dami",
   "type": "speech",
   "text": "THEN YOU'RE NOT CHEAP. YOU'RE LUCKY.",
   "panel_id": "P23",
   "y_top": 24379,
   "y_bottom": 24735,
   "segment": "010.webp",
   "seg_y": 418
  },
  {
   "i": 44,
   "who": "taeo",
   "type": "float",
   "text": "ONE MINUTE OF PENALTY COSTS NEARLY A DAY OF HER PAY.",
   "panel_id": "P23",
   "y_top": 24757,
   "y_bottom": 24882,
   "segment": "010.webp",
   "seg_y": 565
  },
  {
   "i": 45,
   "who": "dokgo",
   "type": "speech",
   "text": "OUR SCOUT GOES IN FIRST. THEN PORTERS. THE CLEAR TEAM, IRONCLAD SEVEN, ENTERS AT THREE.",
   "panel_id": "P24",
   "y_top": 25040,
   "y_bottom": 25398,
   "segment": "010.webp",
   "seg_y": 1081
  },
  {
   "i": 46,
   "who": "dokgo",
   "type": "speech",
   "text": "THE CHEAP ONES GO FIRST.",
   "panel_id": "P24",
   "y_top": 25416,
   "y_bottom": 25570,
   "segment": "010.webp",
   "seg_y": 1253
  },
  {
   "i": 47,
   "who": "mansu",
   "type": "speech",
   "text": "GALLERIES ARE LOW IN THERE, SON.",
   "panel_id": "P26",
   "y_top": 26709,
   "y_bottom": 26931,
   "segment": "011.webp",
   "seg_y": 332
  },
  {
   "i": 48,
   "who": "dami",
   "type": "speech",
   "text": "MY PARTNER. HE CALLS EVERYONE SON.",
   "panel_id": "P26",
   "y_top": 26802,
   "y_bottom": 27023,
   "segment": "011.webp",
   "seg_y": 424
  },
  {
   "i": 49,
   "who": "mansu",
   "type": "speech",
   "text": "GET YOURSELF SOME KNEE PADS.",
   "panel_id": "P26",
   "y_top": 27556,
   "y_bottom": 27710,
   "segment": "011.webp",
   "seg_y": 1111
  },
  {
   "i": 50,
   "who": "nib",
   "type": "speech",
   "text": "I'M SHORT.",
   "panel_id": "P27",
   "y_top": 28073,
   "y_bottom": 28159,
   "segment": "011.webp",
   "seg_y": 1560
  },
  {
   "i": 51,
   "who": "dami",
   "type": "speech",
   "text": "INHALER.",
   "panel_id": "P28",
   "y_top": 28526,
   "y_bottom": 28613,
   "segment": "011.webp",
   "seg_y": 2014
  },
  {
   "i": 52,
   "who": "mansu",
   "type": "speech",
   "text": "MY INHALER'S IN MY JACKET.",
   "panel_id": "P28",
   "y_top": 28562,
   "y_bottom": 28716,
   "segment": "011.webp",
   "seg_y": 2117
  },
  {
   "i": 53,
   "who": "mansu",
   "type": "speech",
   "text": "IT'S FINE.",
   "panel_id": "P28",
   "y_top": 29297,
   "y_bottom": 29384,
   "segment": "011.webp",
   "seg_y": 2785
  },
  {
   "i": 54,
   "who": "mansu",
   "type": "whisper",
   "text": "DON'T MENTION MY ASTHMA NEAR DOKGO.",
   "panel_id": "P29",
   "y_top": 29561,
   "y_bottom": 29807,
   "segment": "012.webp",
   "seg_y": 317
  },
  {
   "i": 55,
   "who": "mansu",
   "type": "whisper",
   "text": "DOKGO DOESN'T PICK WHEEZERS.",
   "panel_id": "P29",
   "y_top": 29829,
   "y_bottom": 30018,
   "segment": "012.webp",
   "seg_y": 528
  },
  {
   "i": 56,
   "who": "taeo",
   "type": "float",
   "text": "GRANDPA SAYS 'IT'S FINE' TOO.",
   "panel_id": "P30",
   "y_top": 30200,
   "y_bottom": 30287,
   "segment": "012.webp",
   "seg_y": 797
  },
  {
   "i": 57,
   "who": "offpanel:gc_manager",
   "type": "phone",
   "text": "SIX HOURS. IS YOUR SPOTTER IN?",
   "panel_id": "P31",
   "y_top": 31376,
   "y_bottom": 31586,
   "segment": "012.webp",
   "seg_y": 2096
  },
  {
   "i": 58,
   "who": "dokgo",
   "type": "speech",
   "text": "GOING IN NOW, SIR.",
   "panel_id": "P31",
   "y_top": 31604,
   "y_bottom": 31759,
   "segment": "012.webp",
   "seg_y": 2269
  },
  {
   "i": 59,
   "who": "minho",
   "type": "speech",
   "text": "SPOTTER IN. NOTHING CLEVER.",
   "panel_id": "P32",
   "y_top": 32481,
   "y_bottom": 32635,
   "segment": "013.webp",
   "seg_y": 264
  },
  {
   "i": 60,
   "who": "taeo",
   "type": "nervous",
   "text": "THE GROUND'S TILTING!",
   "panel_id": "P34",
   "y_top": 34671,
   "y_bottom": 34886,
   "segment": "013.webp",
   "seg_y": 2515
  },
  {
   "i": 61,
   "who": "taeo",
   "type": "speech",
   "text": "I FELT THE GROUND TILT.",
   "panel_id": "P35",
   "y_top": 35561,
   "y_bottom": 35782,
   "segment": "014.webp",
   "seg_y": 306
  },
  {
   "i": 62,
   "who": "haein",
   "type": "speech",
   "text": "OUR GROUND DIDN'T MOVE. YOU FELT NIB'S.",
   "panel_id": "P35",
   "y_top": 35804,
   "y_bottom": 36160,
   "segment": "014.webp",
   "seg_y": 684
  },
  {
   "i": 63,
   "who": "offpanel:nib",
   "type": "phone",
   "text": "INSIDE. ALL THE GROUND HERE SLOPES LEFT.",
   "panel_id": "P36",
   "y_top": 36270,
   "y_bottom": 36480,
   "segment": "014.webp",
   "seg_y": 1004
  },
  {
   "i": 64,
   "who": "taeo",
   "type": "float",
   "text": "THREE SECONDS. THEN I COULDN'T FEEL NIB ANYMORE.",
   "panel_id": "P36",
   "y_top": 36498,
   "y_bottom": 36585,
   "segment": "014.webp",
   "seg_y": 1109
  },
  {
   "i": 65,
   "who": "taeo",
   "type": "speech",
   "text": "AM I BLEEDING?",
   "panel_id": "P37",
   "y_top": 37044,
   "y_bottom": 37199,
   "segment": "014.webp",
   "seg_y": 1723
  },
  {
   "i": 66,
   "who": "haein",
   "type": "speech",
   "text": "NOT YET.",
   "panel_id": "P37",
   "y_top": 37217,
   "y_bottom": 37303,
   "segment": "014.webp",
   "seg_y": 1827
  },
  {
   "i": 67,
   "who": "dokgo",
   "type": "shout",
   "text": "ONE TO EIGHT. GO, GO!",
   "panel_id": "P39",
   "y_top": 40185,
   "y_bottom": 40437,
   "segment": "015.webp",
   "seg_y": 2198
  },
  {
   "i": 68,
   "who": "offpanel:gc_manager",
   "type": "phone",
   "text": "FIVE HOURS.",
   "panel_id": "P41",
   "y_top": 41922,
   "y_bottom": 42069,
   "segment": "016.webp",
   "seg_y": 632
  },
  {
   "i": 69,
   "who": "dokgo",
   "type": "speech",
   "text": "YES SIR. YES SIR. YES SIR.",
   "panel_id": "P41",
   "y_top": 42091,
   "y_bottom": 42312,
   "segment": "016.webp",
   "seg_y": 875
  },
  {
   "i": 70,
   "who": "offpanel:nib",
   "type": "phone",
   "text": "LOOSE SLAB. TWO METRES LEFT OF THE LINE.",
   "panel_id": "P42",
   "y_top": 42527,
   "y_bottom": 42737,
   "segment": "017.webp",
   "seg_y": 320
  },
  {
   "i": 71,
   "who": "minho",
   "type": "speech",
   "text": "MARKED.",
   "panel_id": "P42",
   "y_top": 43351,
   "y_bottom": 43437,
   "segment": "017.webp",
   "seg_y": 1020
  },
  {
   "i": 72,
   "who": "taeo",
   "type": "float",
   "text": "THE WAITING DOESN'T GET EASIER. I JUST GET QUIETER.",
   "panel_id": "P42",
   "y_top": 43455,
   "y_bottom": 43543,
   "segment": "017.webp",
   "seg_y": 1126
  },
  {
   "i": 73,
   "who": "offpanel:gc_manager",
   "type": "phone",
   "text": "FOUR HOURS. YOUR FORWARD CAMP IS TWENTY MINUTES BEHIND. THAT'S ₩1,666,666 IN PENALTIES, MR. DOKGO.",
   "panel_id": "P43",
   "y_top": 43971,
   "y_bottom": 44307,
   "segment": "017.webp",
   "seg_y": 1890
  },
  {
   "i": 74,
   "who": "dokgo",
   "type": "speech",
   "text": "I'LL FIX IT, SIR.",
   "panel_id": "P43",
   "y_top": 44325,
   "y_bottom": 44479,
   "segment": "017.webp",
   "seg_y": 2062
  },
  {
   "i": 75,
   "who": "haein",
   "type": "speech",
   "text": "THAT HANDSET'S FOR SURVEY CALLS. ASK BEFORE YOU USE IT.",
   "panel_id": "P44",
   "y_top": 45201,
   "y_bottom": 45423,
   "segment": "018.webp",
   "seg_y": 332
  },
  {
   "i": 76,
   "who": "dokgo",
   "type": "speech",
   "text": "MY PORTERS CARRY YOUR CABLE.",
   "panel_id": "P44",
   "y_top": 45441,
   "y_bottom": 45663,
   "segment": "018.webp",
   "seg_y": 572
  },
  {
   "i": 77,
   "who": "dokgo",
   "type": "speech",
   "text": "SPLIT THE PAIRS. EVEN NUMBERS TAKE THE LOWER GALLERY.",
   "panel_id": "P44",
   "y_top": 46172,
   "y_bottom": 46394,
   "segment": "018.webp",
   "seg_y": 1303
  },
  {
   "i": 78,
   "who": "minho",
   "type": "speech",
   "text": "THE LOWER GALLERY ISN'T SURVEYED.",
   "panel_id": "P45",
   "y_top": 46526,
   "y_bottom": 46747,
   "segment": "018.webp",
   "seg_y": 1656
  },
  {
   "i": 79,
   "who": "dokgo",
   "type": "speech",
   "text": "IT'S FORTY METRES SHORTER.",
   "panel_id": "P45",
   "y_top": 46618,
   "y_bottom": 46840,
   "segment": "018.webp",
   "seg_y": 1749
  },
  {
   "i": 80,
   "who": "dokgo",
   "type": "speech",
   "text": "THE GALLERY ISN'T ON YOUR SURVEY LINE. SO IT'S NOT YOUR PROBLEM.",
   "panel_id": "P45",
   "y_top": 47349,
   "y_bottom": 47571,
   "segment": "018.webp",
   "seg_y": 2480
  },
  {
   "i": 81,
   "who": "minho",
   "type": "speech",
   "text": "CREW. TAPE THE LOWER GALLERY. BOTH ENDS.",
   "panel_id": "P47",
   "y_top": 48387,
   "y_bottom": 48608,
   "segment": "019.webp",
   "seg_y": 331
  },
  {
   "i": 82,
   "who": "dami",
   "type": "speech",
   "text": "LET ME TAKE THE LOWER GALLERY.",
   "panel_id": "P48",
   "y_top": 49268,
   "y_bottom": 49422,
   "segment": "019.webp",
   "seg_y": 1145
  },
  {
   "i": 83,
   "who": "mansu",
   "type": "speech",
   "text": "YOU'RE FASTER ON THE UPPER RUN. GO ON, KID. IT'S FINE.",
   "panel_id": "P48",
   "y_top": 49440,
   "y_bottom": 49661,
   "segment": "019.webp",
   "seg_y": 1384
  },
  {
   "i": 84,
   "who": "offpanel:gc_manager",
   "type": "phone",
   "text": "THREE HOURS, MR. DOKGO. STILL BEHIND.",
   "panel_id": "P50",
   "y_top": 51675,
   "y_bottom": 51885,
   "segment": "020.webp",
   "seg_y": 616
  },
  {
   "i": 85,
   "who": "dokgo",
   "type": "speech",
   "text": "ROLL CALL. ONE TO EIGHT.",
   "panel_id": "P50",
   "y_top": 51903,
   "y_bottom": 52124,
   "segment": "020.webp",
   "seg_y": 855
  },
  {
   "i": 86,
   "who": "porter",
   "type": "speech",
   "text": "SIX. HERE.",
   "panel_id": "P51",
   "y_top": 52822,
   "y_bottom": 52909,
   "segment": "020.webp",
   "seg_y": 1640
  },
  {
   "i": 87,
   "who": "offpanel:dokgo",
   "type": "phone",
   "text": "SEVEN.",
   "panel_id": "P51",
   "y_top": 52927,
   "y_bottom": 53009,
   "segment": "020.webp",
   "seg_y": 1740
  },
  {
   "i": 88,
   "who": "offpanel:dami",
   "type": "phone",
   "text": "DAMI. FORWARD CAMP.",
   "panel_id": "P52",
   "y_top": 54141,
   "y_bottom": 54351,
   "segment": "020.webp",
   "seg_y": 3082
  },
  {
   "i": 89,
   "who": "dokgo",
   "type": "speech",
   "text": "EIGHT.",
   "panel_id": "P52",
   "y_top": 54373,
   "y_bottom": 54460,
   "segment": "020.webp",
   "seg_y": 3191
  },
  {
   "i": 90,
   "who": "dokgo",
   "type": "speech",
   "text": "EIGHT. KWAK MANSU. ANSWER.",
   "panel_id": "P54",
   "y_top": 55127,
   "y_bottom": 55281,
   "segment": "021.webp",
   "seg_y": 681
  },
  {
   "i": 91,
   "who": "offpanel:nib",
   "type": "phone",
   "text": "KWAK NEVER REACHED THE FORWARD CAMP.",
   "panel_id": "P54",
   "y_top": 55191,
   "y_bottom": 55401,
   "segment": "021.webp",
   "seg_y": 801
  },
  {
   "i": 92,
   "who": "offpanel:dami",
   "type": "phone",
   "text": "KWAK MANSU WENT INTO THE LOWER GALLERY ALONE AT HALF TWELVE.",
   "panel_id": "P56",
   "y_top": 56520,
   "y_bottom": 56793,
   "segment": "021.webp",
   "seg_y": 2193
  },
  {
   "i": 93,
   "who": "offpanel:dokgo",
   "type": "phone",
   "text": "HE'S RESTING SOMEWHERE.",
   "panel_id": "P58",
   "y_top": 60078,
   "y_bottom": 60288,
   "segment": "023.webp",
   "seg_y": 1755
  },
  {
   "i": 94,
   "who": "offpanel:dokgo",
   "type": "phone",
   "text": "KEEP MOVING.",
   "panel_id": "P58",
   "y_top": 60306,
   "y_bottom": 60453,
   "segment": "023.webp",
   "seg_y": 1920
  }
 ],

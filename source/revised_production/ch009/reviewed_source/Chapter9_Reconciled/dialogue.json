{
  "chapter": 9,
  "title": "The Open Side",
  "encoding": "UTF-8",
  "language": "en",
  "lettering_layer": "assembly; no mandatory native phone/tablet text",
  "units": [
    {
      "unit": 1,
      "lines": [
        {
          "order": 1,
          "speaker": "CAPTION",
          "mode": "caption",
          "text": "Monday."
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Can we ask for a place that’s still open?"
        },
        {
          "order": 3,
          "speaker": "TAEO",
          "mode": "speech",
          "text": "Chae?"
        },
        {
          "order": 4,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Yes."
        }
      ]
    },
    {
      "unit": 2,
      "lines": [
        {
          "order": 1,
          "speaker": "CHAE",
          "mode": "phone",
          "text": "Taeo?"
        },
        {
          "order": 2,
          "speaker": "TAEO",
          "mode": "speech",
          "text": "Do you have anything current? From a gate that’s still open?"
        },
        {
          "order": 3,
          "speaker": "CHAE",
          "mode": "phone",
          "text": "Minho’s at a survey site this morning."
        }
      ]
    },
    {
      "unit": 3,
      "lines": [
        {
          "order": 1,
          "speaker": "CHAE",
          "mode": "phone",
          "text": "I’ll send the address. Ask him what he can show you there."
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Can we look from outside?"
        },
        {
          "order": 3,
          "speaker": "CHAE",
          "mode": "phone",
          "text": "Ask him at the entrance. Keep out of the work lanes."
        }
      ]
    },
    {
      "unit": 4,
      "lines": [
        {
          "order": 1,
          "speaker": "TAEO",
          "mode": "speech",
          "text": "I’m at the shop four to ten. Today and tomorrow."
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Then ask when we need to leave."
        }
      ]
    },
    {
      "unit": 5,
      "lines": [
        {
          "order": 1,
          "speaker": "TAEO",
          "mode": "speech",
          "text": "Chae sent us."
        },
        {
          "order": 2,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "Come in this side."
        }
      ]
    },
    {
      "unit": 6,
      "lines": [
        {
          "order": 1,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "You can watch from this bay. Stay south of that barrier."
        },
        {
          "order": 2,
          "speaker": "TAEO",
          "mode": "speech",
          "text": "We need to be back before four."
        },
        {
          "order": 3,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "We’ll be finished here before lunch."
        }
      ]
    },
    {
      "unit": 7,
      "lines": [
        {
          "order": 1,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "This morning’s entrance survey."
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Stone all the way round?"
        },
        {
          "order": 3,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "In the part they photographed."
        }
      ]
    },
    {
      "unit": 8,
      "lines": [
        {
          "order": 1,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Not my wall."
        },
        {
          "order": 2,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "No."
        }
      ]
    },
    {
      "unit": 9,
      "lines": [
        {
          "order": 1,
          "speaker": "TAEO",
          "mode": "speech",
          "text": "Want to go?"
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "I want to see the gate itself."
        },
        {
          "order": 3,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "From the bay. Once we’ve moved the station."
        }
      ]
    },
    {
      "unit": 10,
      "lines": [
        {
          "order": 1,
          "speaker": "NIB",
          "mode": "speech",
          "text": "I can take this end."
        }
      ]
    },
    {
      "unit": 11,
      "lines": [
        {
          "order": 1,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "Leave it to the porter."
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Yes."
        }
      ]
    },
    {
      "unit": 12,
      "lines": [
        {
          "order": 1,
          "speaker": "CREW_A",
          "mode": "speech",
          "text": "Lift. Hold."
        }
      ]
    },
    {
      "unit": 13,
      "lines": [
        {
          "order": 1,
          "speaker": "CREW_B",
          "mode": "speech",
          "text": "Need the drive?"
        },
        {
          "order": 2,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "When you’re unloaded."
        }
      ]
    },
    {
      "unit": 14,
      "lines": [
        {
          "order": 1,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Where does it have to end?"
        },
        {
          "order": 2,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "The low stand. By the radio table."
        }
      ]
    },
    {
      "unit": 15,
      "lines": [
        {
          "order": 1,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Can I check that side?"
        },
        {
          "order": 2,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "The marked lane. Stay clear of the unloading."
        }
      ]
    },
    {
      "unit": 16,
      "lines": []
    },
    {
      "unit": 17,
      "lines": []
    },
    {
      "unit": 18,
      "lines": [
        {
          "order": 1,
          "speaker": "NIB",
          "mode": "speech",
          "text": "This stand?"
        },
        {
          "order": 2,
          "speaker": "RADIO_OPERATOR",
          "mode": "speech",
          "text": "Yes. This side’s clear."
        }
      ]
    },
    {
      "unit": 19,
      "lines": [
        {
          "order": 1,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Down to the south fence, along it, then in by the table."
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "It’s level. The porter fits outside the open door. The stand’s clear."
        }
      ]
    },
    {
      "unit": 20,
      "lines": [
        {
          "order": 1,
          "speaker": "TAEO",
          "mode": "speech",
          "text": "Along the fence, then turn in at the table?"
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "Yes. Outside the unloading."
        }
      ]
    },
    {
      "unit": 21,
      "lines": [
        {
          "order": 1,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "Show me."
        }
      ]
    },
    {
      "unit": 22,
      "lines": [
        {
          "order": 1,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "Yes. Bring it round this side."
        },
        {
          "order": 2,
          "speaker": "CREW_A",
          "mode": "speech",
          "text": "Follow."
        }
      ]
    },
    {
      "unit": 23,
      "lines": []
    },
    {
      "unit": 24,
      "lines": [
        {
          "order": 1,
          "speaker": "CREW_A",
          "mode": "speech",
          "text": "There. Put down."
        },
        {
          "order": 2,
          "speaker": "SFX",
          "mode": "sfx",
          "text": "THUNK."
        }
      ]
    },
    {
      "unit": 25,
      "lines": []
    },
    {
      "unit": 26,
      "lines": [
        {
          "order": 1,
          "speaker": "TAEO",
          "mode": "speech",
          "text": "I thought we’d be waiting for the van."
        },
        {
          "order": 2,
          "speaker": "NIB",
          "mode": "speech",
          "text": "The van won’t fit there. The porter does."
        }
      ]
    },
    {
      "unit": 27,
      "lines": [
        {
          "order": 1,
          "speaker": "RADIO_OPERATOR",
          "mode": "radio",
          "text": "Bay ready."
        },
        {
          "order": 2,
          "speaker": "MINHO",
          "mode": "radio",
          "text": "Heard."
        }
      ]
    },
    {
      "unit": 28,
      "lines": [
        {
          "order": 1,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "You can see it from here."
        }
      ]
    },
    {
      "unit": 29,
      "lines": []
    },
    {
      "unit": 30,
      "lines": [
        {
          "order": 1,
          "speaker": "NIB",
          "mode": "speech",
          "text": "That picture was taken in there?"
        },
        {
          "order": 2,
          "speaker": "MINHO",
          "mode": "speech",
          "text": "Yes."
        }
      ]
    },
    {
      "unit": 31,
      "lines": [
        {
          "order": 1,
          "speaker": "NIB",
          "mode": "speech",
          "text": "At least this one’s here."
        }
      ]
    },
    {
      "unit": 32,
      "lines": []
    },
    {
      "unit": 33,
      "lines": []
    }
  ]
}

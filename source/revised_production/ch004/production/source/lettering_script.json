      ]
    },
    {
      "panel": 38,
      "items": [
        {
          "item_id": "ch04-p038-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "You said dungeon.",
          "source_line": 350,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p038-d02",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "I guessed.",
          "source_line": 352,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p038-d03",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "This is somewhere we can check. It doesn't mean that's where you're from.",
          "source_line": 354,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 39,
      "items": [
        {
          "item_id": "ch04-p039-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "Not that.",
          "source_line": 362,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p039-d02",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "All right.",
          "source_line": 364,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 40,
      "items": [
        {
          "item_id": "ch04-p040-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "I'll send you the recordings and keep checking the arrival report.",
          "source_line": 374,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p040-d02",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Don't try a dismissal to see what happens. We haven't established where he'd go.",
          "source_line": 376,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": [
        {
          "item_id": "ch04-p040-a01",
          "kind": "assessment_sheet",
          "text": "Low output. Intermittent sensory response.",
          "source_line": 372,
          "owner": "art",
          "treatment": "preserve independently accepted art; no lettering overlay authorized"
        }
      ]
    },
    {
      "panel": 41,
      "items": [
        {
          "item_id": "ch04-p041-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "I won't.",
          "source_line": 384,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p041-d02",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "If you find a place that looks familiar, send it to me.",
          "source_line": 388,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 42,
      "items": [
        {
          "item_id": "ch04-p042-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "This is where I work.",
          "source_line": 402,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 43,
      "items": [
        {
          "item_id": "ch04-p043-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "Where's the gate?",
          "source_line": 408,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p043-d02",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Gone. The hunters cleared it.",
          "source_line": 410,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 44,
      "items": [
        {
          "item_id": "ch04-p044-d01",
          "kind": "dialogue",
          "speaker": "COWORKER",
          "text": "You brought someone.",
          "source_line": 418,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p044-d02",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "This is Nib. I awakened yesterday.",
          "source_line": 420,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 45,
      "items": [
        {
          "item_id": "ch04-p045-d01",
          "kind": "dialogue",
          "speaker": "COWORKER",
          "text": "Yesterday?",
          "source_line": 428,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p045-d02",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "After we got out.",
          "source_line": 430,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 46,
      "items": [
        {
          "item_id": "ch04-p046-d01",
          "kind": "dialogue",
          "speaker": "COWORKER",
          "text": "Does he need to stay near you?",
          "source_line": 440,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p046-d02",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "We don't know how far yet.",
          "source_line": 442,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 47,
      "items": [
        {
          "item_id": "ch04-p047-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Can he wait in the break room while I'm here? I'll ask the manager too.",
          "source_line": 448,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p047-d02",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "I can hear you.",
          "source_line": 450,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 48,
      "items": [
        {
          "item_id": "ch04-p048-d01",
          "kind": "dialogue",
          "speaker": "COWORKER",
          "text": "Oh.",
          "source_line": 456,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p048-d02",
          "kind": "dialogue",
          "speaker": "COWORKER",
          "text": "It's small back there. I'll show you.",
          "source_line": 460,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 49,
      "items": [

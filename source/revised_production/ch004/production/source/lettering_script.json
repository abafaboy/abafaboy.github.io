{
  "title": "My Summons Go First",
  "chapter": 4,
  "chapter_title": "Something There",
  "script_sha256": "94635a4cf683117720444a8a7c96db4b7e679e7a9377baf58214ecb48e4cccee",
  "status": "reviewed handoff; exact dialogue extraction for preparation; no new story or dialogue",
  "panels": [
    {
      "panel": 1,
      "items": [
        {
          "item_id": "ch04-p001-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Hold out a hand. Both of you.",
          "source_line": 22,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 2,
      "items": [
        {
          "item_id": "ch04-p002-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "These only measure. They won't move either of you.",
          "source_line": 30,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 3,
      "items": [
        {
          "item_id": "ch04-p003-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Taeo, look at Nib. Don't try to give him an order.",
          "source_line": 38,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 4,
      "items": [
        {
          "item_id": "ch04-p004-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "Do you have to do that?",
          "source_line": 46,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p004-d02",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Do what?",
          "source_line": 48,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 5,
      "items": [
        {
          "item_id": "ch04-p005-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Sorry.",
          "source_line": 56,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 6,
      "items": [
        {
          "item_id": "ch04-p006-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Breathe. You're looking for a feeling, not trying to make something happen.",
          "source_line": 62,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 7,
      "items": [],
      "generated_text": []
    },
    {
      "panel": 8,
      "items": [],
      "generated_text": []
    },
    {
      "panel": 9,
      "items": [
        {
          "item_id": "ch04-p009-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Wait.",
          "source_line": 82,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 10,
      "items": [
        {
          "item_id": "ch04-p010-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "There was something. Here.",
          "source_line": 90,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p010-d02",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "What did it feel like?",
          "source_line": 94,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 11,
      "items": [
        {
          "item_id": "ch04-p011-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Like someone pressing it.",
          "source_line": 98,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 12,
      "items": [
        {
          "item_id": "ch04-p012-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Both readings changed there.",
          "source_line": 108,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p012-d02",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "Is that the way back?",
          "source_line": 112,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 13,
      "items": [
        {
          "item_id": "ch04-p013-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Not by itself. We need to find out what passed between you.",
          "source_line": 118,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 14,
      "items": [
        {
          "item_id": "ch04-p014-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Nib, press this with your free hand when I point. Gently.",
          "source_line": 130,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 15,
      "items": [
        {
          "item_id": "ch04-p015-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Face that way. Tell us if you feel it again.",
          "source_line": 138,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 16,
      "items": [],
      "generated_text": []
    },
    {
      "panel": 17,
      "items": [
        {
          "item_id": "ch04-p017-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Now.",
          "source_line": 152,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 18,
      "items": [
        {
          "item_id": "ch04-p018-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Gone.",
          "source_line": 160,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 19,
      "items": [],
      "generated_text": []
    },
    {
      "panel": 20,
      "items": [
        {
          "item_id": "ch04-p020-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "There.",
          "source_line": 178,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 21,
      "items": [
        {
          "item_id": "ch04-p021-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "Which hand?",
          "source_line": 186,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 22,
      "items": [
        {
          "item_id": "ch04-p022-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "My left.",
          "source_line": 192,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p022-d02",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "I mean mine.",
          "source_line": 194,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p022-d03",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "I don't know.",
          "source_line": 196,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 23,
      "items": [
        {
          "item_id": "ch04-p023-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "What am I doing now?",
          "source_line": 204,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p023-d02",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "I can't tell.",
          "source_line": 208,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 24,
      "items": [
        {
          "item_id": "ch04-p024-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "All right. Turn around.",
          "source_line": 214,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p024-d02",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "You felt pressure twice without watching. You didn't see what he was doing.",
          "source_line": 218,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 25,
      "items": [
        {
          "item_id": "ch04-p025-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "Once more.",
          "source_line": 224,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 26,
      "items": [
        {
          "item_id": "ch04-p026-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Nothing.",
          "source_line": 236,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 27,
      "items": [
        {
          "item_id": "ch04-p027-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Don't press harder.",
          "source_line": 242,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 28,
      "items": [
        {
          "item_id": "ch04-p028-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "I had it.",
          "source_line": 250,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p028-d02",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "You did. And this time you didn't.",
          "source_line": 252,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 29,
      "items": [
        {
          "item_id": "ch04-p029-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Now try bringing up those words again. Just look. Don't select anything.",
          "source_line": 264,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p029-d02",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Still nothing.",
          "source_line": 268,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p029-d03",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "All right. Leave it for now.",
          "source_line": 270,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 30,
      "items": [
        {
          "item_id": "ch04-p030-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "Could that work when he's somewhere else?",
          "source_line": 280,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p030-d02",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Maybe. We haven't tested distance.",
          "source_line": 282,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 31,
      "items": [
        {
          "item_id": "ch04-p031-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "But you can't send me back.",
          "source_line": 290,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p031-d02",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "I can't do that with what we've found.",
          "source_line": 294,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 32,
      "items": [],
      "generated_text": []
    },
    {
      "panel": 33,
      "items": [
        {
          "item_id": "ch04-p033-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "There must be something we can look for.",
          "source_line": 306,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p033-d02",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "My watch post.",
          "source_line": 308,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 34,
      "items": [
        {
          "item_id": "ch04-p034-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "Show me.",
          "source_line": 316,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 35,
      "items": [
        {
          "item_id": "ch04-p035-d01",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "Wall here. Tree behind it.",
          "source_line": 324,
          "transmitted": false,
          "off_panel": false
        },
        {
          "item_id": "ch04-p035-d02",
          "kind": "dialogue",
          "speaker": "NIB",
          "text": "I sat here. You could see the lower path.",
          "source_line": 328,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 36,
      "items": [
        {
          "item_id": "ch04-p036-d01",
          "kind": "dialogue",
          "speaker": "TAEO",
          "text": "How tall was the wall?",
          "source_line": 334,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": []
    },
    {
      "panel": 37,
      "items": [
        {
          "item_id": "ch04-p037-d01",
          "kind": "dialogue",
          "speaker": "CHAE",
          "text": "We have recordings from surveyed gates. We can start by looking for that landscape.",
          "source_line": 344,
          "transmitted": false,
          "off_panel": false
        }
      ],
      "generated_text": [
        {
          "item_id": "ch04-p037-a01",
          "kind": "prop_heading",
          "text": "PUBLIC GATE SURVEYS",
          "source_line": 342,
          "owner": "art",
          "treatment": "preserve independently accepted art; no lettering overlay authorized"

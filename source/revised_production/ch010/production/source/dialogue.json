{
  "source": "CH010_script.md",
  "sha256": "608bdde444ac3c6cb445c2f2cf32900cb426c80a7bc6c591c493772485531afc",
  "entries": [
    {
      "unit_id": "P01",
      "speaker_and_delivery": "OPERATOR",
      "text": "Reception lane's clear."
    },
    {
      "unit_id": "P01",
      "speaker_and_delivery": "MINHO",
      "text": "Keep that side open."
    },
    {
      "unit_id": "P02",
      "speaker_and_delivery": "TAEO",
      "text": "If Nib goes in, could I tell you what I feel?"
    },
    {
      "unit_id": "P02",
      "speaker_and_delivery": "MINHO",
      "text": "What have you felt?"
    },
    {
      "unit_id": "P03",
      "speaker_and_delivery": "TAEO",
      "text": "Pressure here. I felt it twice with Chae. Then I missed one."
    },
    {
      "unit_id": "P03",
      "speaker_and_delivery": "MINHO",
      "text": "And since then?"
    },
    {
      "unit_id": "P03",
      "speaker_and_delivery": "TAEO",
      "text": "We haven't tried again."
    },
    {
      "unit_id": "P04",
      "speaker_and_delivery": "CLIP VOICE",
      "text": "Relax your hand. Wait for a change."
    },
    {
      "unit_id": "P05",
      "speaker_and_delivery": "TAEO",
      "text": "Could we try out here? With me turned away."
    },
    {
      "unit_id": "P05",
      "speaker_and_delivery": "NIB",
      "text": "What am I pressing?"
    },
    {
      "unit_id": "P05",
      "speaker_and_delivery": "MINHO",
      "text": "Something that stays put. I'll watch."
    },
    {
      "unit_id": "P06",
      "speaker_and_delivery": "MINHO",
      "text": "Just a gentle press. Stop whenever you want."
    },
    {
      "unit_id": "P06",
      "speaker_and_delivery": "NIB",
      "text": "All right."
    },
    {
      "unit_id": "P07",
      "speaker_and_delivery": "MINHO",
      "text": "Say when you feel something. Don't guess which one."
    },
    {
      "unit_id": "P09",
      "speaker_and_delivery": "TAEO",
      "text": "There."
    },
    {
      "unit_id": "P09",
      "speaker_and_delivery": "TAEO",
      "text": "Gone."
    },
    {
      "unit_id": "P11",
      "speaker_and_delivery": "TAEO",
      "text": "There again."
    },
    {
      "unit_id": "P11",
      "speaker_and_delivery": "TAEO",
      "text": "Gone."
    },
    {
      "unit_id": "P13",
      "speaker_and_delivery": "TAEO",
      "text": "Nothing yet."
    },
    {
      "unit_id": "P14",
      "speaker_and_delivery": "MINHO",
      "text": "That's enough. Turn round."
    },
    {
      "unit_id": "P15",
      "speaker_and_delivery": "TAEO",
      "text": "If we give it a little—"
    },
    {
      "unit_id": "P15",
      "speaker_and_delivery": "NIB",
      "text": "I was already pressing."
    },
    {
      "unit_id": "P16",
      "speaker_and_delivery": "TAEO",
      "text": "And I didn't feel it."
    },
    {
      "unit_id": "P17",
      "speaker_and_delivery": "TAEO",
      "text": "Could still be an extra warning."
    },
    {
      "unit_id": "P17",
      "speaker_and_delivery": "MINHO",
      "text": "Extra. We won't wait for it."
    },
    {
      "unit_id": "P18",
      "speaker_and_delivery": "OPERATOR, RADIO",
      "text": "Minho. Equipment coming through southwest."
    },
    {
      "unit_id": "P18",
      "speaker_and_delivery": "MINHO, RADIO",
      "text": "Hold it. We're clearing this side."
    },
    {
      "unit_id": "P20",
      "speaker_and_delivery": "MINHO, RADIO",
      "text": "Clear now. Send it."
    },
    {
      "unit_id": "P20",
      "speaker_and_delivery": "OPERATOR, RADIO",
      "text": "Moving to the station."
    },
    {
      "unit_id": "P21",
      "speaker_and_delivery": "NIB",
      "text": "What do I hear when you want us out?"
    },
    {
      "unit_id": "P21",
      "speaker_and_delivery": "MINHO",
      "text": "My voice. We practice that before you go anywhere."
    },
    {
      "unit_id": "P22",
      "speaker_and_delivery": "MINHO",
      "text": "If we do this, I go with you. Just inside, straight back. After the exit briefing and your kit."
    },
    {
      "unit_id": "P22",
      "speaker_and_delivery": "NIB",
      "text": "Then show me what to say."
    },
    {
      "unit_id": "P23",
      "speaker_and_delivery": "MINHO",
      "text": "When I call withdrawal, say where you're going. Then come with me."
    },
    {
      "unit_id": "P23",
      "speaker_and_delivery": "NIB",
      "text": "If this goes quiet?"
    },
    {
      "unit_id": "P23",
      "speaker_and_delivery": "MINHO",
      "text": "We stop the trial and walk back together."
    },
    {
      "unit_id": "P24",
      "speaker_and_delivery": "OPERATOR",
      "text": "Taeo, beside me. Only report what you notice."
    },
    {
      "unit_id": "P24",
      "speaker_and_delivery": "TAEO",
      "text": "All right."
    },
    {
      "unit_id": "P26",
      "speaker_and_delivery": "MINHO, RADIO",
      "text": "Nib, withdraw with me. Back to staging."
    },
    {
      "unit_id": "P27",
      "speaker_and_delivery": "NIB, RADIO",
      "text": "With you. Back to staging."
    },
    {
      "unit_id": "P29",
      "speaker_and_delivery": "NIB, RADIO",
      "text": "Nib and Minho at staging."
    },
    {
      "unit_id": "P29",
      "speaker_and_delivery": "OPERATOR, RADIO",
      "text": "Both seen."
    },
    {
      "unit_id": "P30",
      "speaker_and_delivery": "MINHO",
      "text": "Between those first two presses, I had him touch nothing. What did you get?"
    },
    {
      "unit_id": "P30",
      "speaker_and_delivery": "TAEO",
      "text": "I felt those two. Nothing in between. And I missed the last one."
    },
    {
      "unit_id": "P31",
      "speaker_and_delivery": "TAEO",
      "text": "Put the miss in, too."
    },
    {
      "unit_id": "P31",
      "speaker_and_delivery": "MINHO",
      "text": "We'll use the radio to bring him back."
    },
    {
      "unit_id": "P32",
      "speaker_and_delivery": "OPERATOR, RADIO",
      "text": "Staging ready."
    }
  ]
}

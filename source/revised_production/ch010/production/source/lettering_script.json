{
  "chapter": 10,
  "title": "A Missed Signal",
  "script_sha256": "608bdde444ac3c6cb445c2f2cf32900cb426c80a7bc6c591c493772485531afc",
  "dialogue_json_sha256": "460c4109edac3c6fea8decd93fc59f78cf08a39ddf833062e86704348c1abafb",
  "panels": [
    {
      "panel": 1,
      "unit": 1,
      "unit_id": "P01",
      "items": [
        {
          "speaker": "OPERATOR",
          "speaker_and_delivery": "OPERATOR",
          "text": "Reception lane's clear.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "Keep that side open.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 2,
      "unit": 2,
      "unit_id": "P02",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "If Nib goes in, could I tell you what I feel?",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "What have you felt?",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 3,
      "unit": 3,
      "unit_id": "P03",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "Pressure here. I felt it twice with Chae. Then I missed one.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "And since then?",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        },
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "We haven't tried again.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 3
        }
      ]
    },
    {
      "panel": 4,
      "unit": 4,
      "unit_id": "P04",
      "items": [
        {
          "speaker": "CLIP VOICE",
          "speaker_and_delivery": "CLIP VOICE",
          "text": "Relax your hand. Wait for a change.",
          "kind": "dialogue",
          "delivery": "clip",
          "transmitted": true,
          "source_order": 1
        }
      ]
    },
    {
      "panel": 5,
      "unit": 5,
      "unit_id": "P05",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "Could we try out here? With me turned away.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "NIB",
          "speaker_and_delivery": "NIB",
          "text": "What am I pressing?",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "Something that stays put. I'll watch.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 3
        }
      ]
    },
    {
      "panel": 6,
      "unit": 6,
      "unit_id": "P06",
      "items": [
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "Just a gentle press. Stop whenever you want.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "NIB",
          "speaker_and_delivery": "NIB",
          "text": "All right.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 7,
      "unit": 7,
      "unit_id": "P07",
      "items": [
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "Say when you feel something. Don't guess which one.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        }
      ]
    },
    {
      "panel": 8,
      "unit": 8,
      "unit_id": "P08",
      "items": []
    },
    {
      "panel": 9,
      "unit": 9,
      "unit_id": "P09",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "There.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "Gone.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 10,
      "unit": 10,
      "unit_id": "P10",
      "items": []
    },
    {
      "panel": 11,
      "unit": 11,
      "unit_id": "P11",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "There again.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "Gone.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 12,
      "unit": 12,
      "unit_id": "P12",
      "items": []
    },
    {
      "panel": 13,
      "unit": 13,
      "unit_id": "P13",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "Nothing yet.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        }
      ]
    },
    {
      "panel": 14,
      "unit": 14,
      "unit_id": "P14",
      "items": [
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "That's enough. Turn round.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        }
      ]
    },
    {
      "panel": 15,
      "unit": 15,
      "unit_id": "P15",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "If we give it a little—",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "NIB",
          "speaker_and_delivery": "NIB",
          "text": "I was already pressing.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 16,
      "unit": 16,
      "unit_id": "P16",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "And I didn't feel it.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        }
      ]
    },
    {
      "panel": 17,
      "unit": 17,
      "unit_id": "P17",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "Could still be an extra warning.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "Extra. We won't wait for it.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 18,
      "unit": 18,
      "unit_id": "P18",
      "items": [
        {
          "speaker": "OPERATOR",
          "speaker_and_delivery": "OPERATOR, RADIO",
          "text": "Minho. Equipment coming through southwest.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 1
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO, RADIO",
          "text": "Hold it. We're clearing this side.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 19,
      "unit": 19,
      "unit_id": "P19",
      "items": []
    },
    {
      "panel": 20,
      "unit": 20,
      "unit_id": "P20",
      "items": [
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO, RADIO",
          "text": "Clear now. Send it.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 1
        },
        {
          "speaker": "OPERATOR",
          "speaker_and_delivery": "OPERATOR, RADIO",
          "text": "Moving to the station.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 21,
      "unit": 21,
      "unit_id": "P21",
      "items": [
        {
          "speaker": "NIB",
          "speaker_and_delivery": "NIB",
          "text": "What do I hear when you want us out?",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "My voice. We practice that before you go anywhere.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 22,
      "unit": 22,
      "unit_id": "P22",
      "items": [
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "If we do this, I go with you. Just inside, straight back. After the exit briefing and your kit.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "NIB",
          "speaker_and_delivery": "NIB",
          "text": "Then show me what to say.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 23,
      "unit": 23,
      "unit_id": "P23",
      "items": [
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "When I call withdrawal, say where you're going. Then come with me.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "NIB",
          "speaker_and_delivery": "NIB",
          "text": "If this goes quiet?",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "We stop the trial and walk back together.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 3
        }
      ]
    },
    {
      "panel": 24,
      "unit": 24,
      "unit_id": "P24",
      "items": [
        {
          "speaker": "OPERATOR",
          "speaker_and_delivery": "OPERATOR",
          "text": "Taeo, beside me. Only report what you notice.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "All right.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 25,
      "unit": 25,
      "unit_id": "P25",
      "items": []
    },
    {
      "panel": 26,
      "unit": 26,
      "unit_id": "P26",
      "items": [
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO, RADIO",
          "text": "Nib, withdraw with me. Back to staging.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 1
        }
      ]
    },
    {
      "panel": 27,
      "unit": 27,
      "unit_id": "P27",
      "items": [
        {
          "speaker": "NIB",
          "speaker_and_delivery": "NIB, RADIO",
          "text": "With you. Back to staging.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 1
        }
      ]
    },
    {
      "panel": 28,
      "unit": 28,
      "unit_id": "P28",
      "items": []
    },
    {
      "panel": 29,
      "unit": 29,
      "unit_id": "P29",
      "items": [
        {
          "speaker": "NIB",
          "speaker_and_delivery": "NIB, RADIO",
          "text": "Nib and Minho at staging.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 1
        },
        {
          "speaker": "OPERATOR",
          "speaker_and_delivery": "OPERATOR, RADIO",
          "text": "Both seen.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 30,
      "unit": 30,
      "unit_id": "P30",
      "items": [
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "Between those first two presses, I had him touch nothing. What did you get?",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "I felt those two. Nothing in between. And I missed the last one.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 31,
      "unit": 31,
      "unit_id": "P31",
      "items": [
        {
          "speaker": "TAEO",
          "speaker_and_delivery": "TAEO",
          "text": "Put the miss in, too.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 1
        },
        {
          "speaker": "MINHO",
          "speaker_and_delivery": "MINHO",
          "text": "We'll use the radio to bring him back.",
          "kind": "dialogue",
          "delivery": "speech",
          "transmitted": false,
          "source_order": 2
        }
      ]
    },
    {
      "panel": 32,
      "unit": 32,
      "unit_id": "P32",
      "items": [
        {
          "speaker": "OPERATOR",
          "speaker_and_delivery": "OPERATOR, RADIO",
          "text": "Staging ready.",
          "kind": "dialogue",
          "delivery": "radio",
          "transmitted": true,
          "source_order": 1
        }
      ]
    }
  ]
}

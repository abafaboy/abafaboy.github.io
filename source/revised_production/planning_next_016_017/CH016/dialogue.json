{
  "source_sha256": "8e2af2ae22d21b6f13144aa82cef0ca6a87403e1ad5ef3e0448458857f412231",
  "lines": [
    {
      "unit_id": "U01",
      "line_id": "CH016-U01-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Made it."
    },
    {
      "unit_id": "U01",
      "line_id": "CH016-U01-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "You still have to work."
    },
    {
      "unit_id": "U02",
      "line_id": "CH016-U02-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Can he use the break room again? Just this shift."
    },
    {
      "unit_id": "U02",
      "line_id": "CH016-U02-L02",
      "speaker_and_delivery": "COWORKER | speech",
      "text": "I'll ask."
    },
    {
      "unit_id": "U03",
      "line_id": "CH016-U03-L01",
      "speaker_and_delivery": "COWORKER | speech",
      "text": "Manager says yes. Leave the doorway clear."
    },
    {
      "unit_id": "U03",
      "line_id": "CH016-U03-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "All right."
    },
    {
      "unit_id": "U04",
      "line_id": "CH016-U04-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "The drawings after work."
    },
    {
      "unit_id": "U04",
      "line_id": "CH016-U04-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "I remember."
    },
    {
      "unit_id": "U05",
      "line_id": "CH016-U05-L01",
      "speaker_and_delivery": "CAPTION | time",
      "text": "After ten."
    },
    {
      "unit_id": "U07",
      "line_id": "CH016-U07-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Start at the bay?"
    },
    {
      "unit_id": "U07",
      "line_id": "CH016-U07-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Where they loaded the stretcher."
    },
    {
      "unit_id": "U08",
      "line_id": "CH016-U08-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "North. Then west."
    },
    {
      "unit_id": "U08",
      "line_id": "CH016-U08-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Then south. That last bit to the entrance."
    },
    {
      "unit_id": "U08",
      "line_id": "CH016-U08-L03",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I had that one."
    },
    {
      "unit_id": "U08",
      "line_id": "CH016-U08-L04",
      "speaker_and_delivery": "NIB | speech",
      "text": "Good. Keep it."
    },
    {
      "unit_id": "U09",
      "line_id": "CH016-U09-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "This is the way you walked in. Why couldn't they carry the stretcher back here?"
    },
    {
      "unit_id": "U10",
      "line_id": "CH016-U10-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "Two stone shoulders. You turn between them. We could walk through. The stretcher couldn't turn flat."
    },
    {
      "unit_id": "U11",
      "line_id": "CH016-U11-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "They tried it empty. Before they moved the worker."
    },
    {
      "unit_id": "U11",
      "line_id": "CH016-U11-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I didn't hear that part."
    },
    {
      "unit_id": "U12",
      "line_id": "CH016-U12-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "How wide was it?"
    },
    {
      "unit_id": "U12",
      "line_id": "CH016-U12-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "I didn't measure it."
    },
    {
      "unit_id": "U12",
      "line_id": "CH016-U12-L03",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Right."
    },
    {
      "unit_id": "U13",
      "line_id": "CH016-U13-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I nearly sent you back for the samples."
    },
    {
      "unit_id": "U13",
      "line_id": "CH016-U13-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "You told me to leave them."
    },
    {
      "unit_id": "U14",
      "line_id": "CH016-U14-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I was still trying to keep the bonus. I'm sorry."
    },
    {
      "unit_id": "U14",
      "line_id": "CH016-U14-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "I wanted the money too. I wasn't leaving them there."
    },
    {
      "unit_id": "U15",
      "line_id": "CH016-U15-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Tell me where you waited."
    },
    {
      "unit_id": "U15",
      "line_id": "CH016-U15-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Here. Minho wanted me where he could see me."
    },
    {
      "unit_id": "U16",
      "line_id": "CH016-U16-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "When I felt it?"
    },
    {
      "unit_id": "U16",
      "line_id": "CH016-U16-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Near there. I had my hand on the support. Then we stopped, and I saw the mark on the floor."
    },
    {
      "unit_id": "U16",
      "line_id": "CH016-U16-L03",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I still don't know what part I felt."
    },
    {
      "unit_id": "U16",
      "line_id": "CH016-U16-L04",
      "speaker_and_delivery": "NIB | speech",
      "text": "Neither do I."
    },
    {
      "unit_id": "U17",
      "line_id": "CH016-U17-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "After the turn, we slowed down. Then we stopped once more by the entrance."
    },
    {
      "unit_id": "U17",
      "line_id": "CH016-U17-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I heard that call."
    },
    {
      "unit_id": "U18",
      "line_id": "CH016-U18-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "That's all the way out."
    },
    {
      "unit_id": "U18",
      "line_id": "CH016-U18-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "That's the way we used."
    },
    {
      "unit_id": "U19",
      "line_id": "CH016-U19-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "The recordings."
    },
    {
      "unit_id": "U20",
      "line_id": "CH016-U20-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "You won't remember this either."
    },
    {
      "unit_id": "U20",
      "line_id": "CH016-U20-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I'm awake."
    },
    {
      "unit_id": "U21",
      "line_id": "CH016-U21-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Morning? Before we do anything else."
    },
    {
      "unit_id": "U21",
      "line_id": "CH016-U21-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Before your next drawing."
    },
    {
      "unit_id": "U21",
      "line_id": "CH016-U21-L03",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Yes."
    },
    {
      "unit_id": "U22",
      "line_id": "CH016-U22-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "You got the last turn right."
    },
    {
      "unit_id": "U22",
      "line_id": "CH016-U22-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I wrote it down three times today."
    }
  ]
}

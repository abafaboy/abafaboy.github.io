{
  "source_sha256": "ea5ce802ec4ccee47ef1340be9f837a727f41469083804ce97976393a23210c2",
  "lines": [
    {
      "unit_id": "U01",
      "line_id": "CH017-U01-L01",
      "speaker_and_delivery": "CAPTION | time",
      "text": "Wednesday morning."
    },
    {
      "unit_id": "U01",
      "line_id": "CH017-U01-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Recordings first."
    },
    {
      "unit_id": "U03",
      "line_id": "CH017-U03-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "The next one. We keep coming back to that rock."
    },
    {
      "unit_id": "U04",
      "line_id": "CH017-U04-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "Let it run."
    },
    {
      "unit_id": "U06",
      "line_id": "CH017-U06-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "Can it look up there?"
    },
    {
      "unit_id": "U06",
      "line_id": "CH017-U06-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Only if whoever filmed it turned."
    },
    {
      "unit_id": "U08",
      "line_id": "CH017-U08-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "That's all?"
    },
    {
      "unit_id": "U08",
      "line_id": "CH017-U08-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "That's the end of this one."
    },
    {
      "unit_id": "U09",
      "line_id": "CH017-U09-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "I used to look down at the path. From the post."
    },
    {
      "unit_id": "U09",
      "line_id": "CH017-U09-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "This camera stayed on the path."
    },
    {
      "unit_id": "U10",
      "line_id": "CH017-U10-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Does any of it look familiar?"
    },
    {
      "unit_id": "U10",
      "line_id": "CH017-U10-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Not enough. A path's a path."
    },
    {
      "unit_id": "U11",
      "line_id": "CH017-U11-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Want to keep where we got to?"
    },
    {
      "unit_id": "U11",
      "line_id": "CH017-U11-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Yes. Leave the picture there."
    },
    {
      "unit_id": "U12",
      "line_id": "CH017-U12-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "We haven't seen above this."
    },
    {
      "unit_id": "U12",
      "line_id": "CH017-U12-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I'll ask Chae if there's another view."
    },
    {
      "unit_id": "U13",
      "line_id": "CH017-U13-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "Ask for higher up. Not another trip along the same path."
    },
    {
      "unit_id": "U13",
      "line_id": "CH017-U13-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I'll say that."
    },
    {
      "unit_id": "U14",
      "line_id": "CH017-U14-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "“We've looked at the second recording. Do you have another view from higher up that slope?”"
    },
    {
      "unit_id": "U14",
      "line_id": "CH017-U14-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Tell her I haven't found it."
    },
    {
      "unit_id": "U14",
      "line_id": "CH017-U14-L03",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Okay."
    },
    {
      "unit_id": "U15",
      "line_id": "CH017-U15-L01",
      "speaker_and_delivery": "TAEO | reading message",
      "text": "We've looked at the second recording in the six you sent. Nib hasn't found his watch post. Does that survey have another view from higher up the slope?"
    },
    {
      "unit_id": "U15",
      "line_id": "CH017-U15-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "That."
    },
    {
      "unit_id": "U16",
      "line_id": "CH017-U16-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "She won't answer faster if you pick it up."
    },
    {
      "unit_id": "U16",
      "line_id": "CH017-U16-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I know."
    },
    {
      "unit_id": "U17",
      "line_id": "CH017-U17-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I want to ask Minho for another ground practice."
    },
    {
      "unit_id": "U17",
      "line_id": "CH017-U17-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "With the radio?"
    },
    {
      "unit_id": "U17",
      "line_id": "CH017-U17-L03",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Yes. Nothing through a gate."
    },
    {
      "unit_id": "U17",
      "line_id": "CH017-U17-L04",
      "speaker_and_delivery": "TAEO | speech",
      "text": "A route I haven't watched you walk. I draw what you tell me. Then we check it."
    },
    {
      "unit_id": "U17",
      "line_id": "CH017-U17-L05",
      "speaker_and_delivery": "NIB | speech",
      "text": "Check it with what?"
    },
    {
      "unit_id": "U18",
      "line_id": "CH017-U18-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I hadn't got that far."
    },
    {
      "unit_id": "U18",
      "line_id": "CH017-U18-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "Carrying something changes the turn. We found that out."
    },
    {
      "unit_id": "U19",
      "line_id": "CH017-U19-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "Ask Minho what we can safely use. Something empty."
    },
    {
      "unit_id": "U19",
      "line_id": "CH017-U19-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "And who has to walk beside it."
    },
    {
      "unit_id": "U19",
      "line_id": "CH017-U19-L03",
      "speaker_and_delivery": "TAEO | speech",
      "text": "That too."
    },
    {
      "unit_id": "U20",
      "line_id": "CH017-U20-L01",
      "speaker_and_delivery": "NIB | speech",
      "text": "If Minho agrees, I want to see it before we start."
    },
    {
      "unit_id": "U20",
      "line_id": "CH017-U20-L02",
      "speaker_and_delivery": "TAEO | speech",
      "text": "You will."
    },
    {
      "unit_id": "U21",
      "line_id": "CH017-U21-L01",
      "speaker_and_delivery": "TAEO | speech",
      "text": "I'll ask about the practice after she answers."
    },
    {
      "unit_id": "U21",
      "line_id": "CH017-U21-L02",
      "speaker_and_delivery": "NIB | speech",
      "text": "You can ask. Just don't lose my place."
    }
  ]
}

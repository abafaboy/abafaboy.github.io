 "lines": [
  {
   "i": 1,
   "who": "taeo",
   "type": "float",
   "text": "I KNEW WHERE HE'D GONE.",
   "panel_id": "P02",
   "y_top": 2026,
   "y_bottom": 2113,
   "segment": "001.webp",
   "seg_y": 2113
  },
  {
   "i": 2,
   "who": "seonhee",
   "type": "speech",
   "text": "IT'S NOT EVEN SEVEN.",
   "panel_id": "P03",
   "y_top": 3123,
   "y_bottom": 3344,
   "segment": "002.webp",
   "seg_y": 411
  },
  {
   "i": 3,
   "who": "nib",
   "type": "speech",
   "text": "I'M A PERSON NOW. ON PAPER.",
   "panel_id": "P04",
   "y_top": 3643,
   "y_bottom": 3797,
   "segment": "002.webp",
   "seg_y": 864
  },
  {
   "i": 4,
   "who": "nib",
   "type": "speech",
   "text": "I WANT WORK. INSIDE A GATE.",
   "panel_id": "P04",
   "y_top": 3815,
   "y_bottom": 3970,
   "segment": "002.webp",
   "seg_y": 1037
  },
  {
   "i": 5,
   "who": "seonhee",
   "type": "speech",
   "text": "MINHO'S ASLEEP. YOU CAN WAIT.",
   "panel_id": "P06",
   "y_top": 6808,
   "y_bottom": 6962,
   "segment": "004.webp",
   "seg_y": 560
  },
  {
   "i": 6,
   "who": "seonhee",
   "type": "speech",
   "text": "DRINK YOUR TEA. YOU'RE GOING BLUE.",
   "panel_id": "P06",
   "y_top": 6980,
   "y_bottom": 7202,
   "segment": "004.webp",
   "seg_y": 800
  },
  {
   "i": 7,
   "who": "nib",
   "type": "speech",
   "text": "I'M GREEN.",
   "panel_id": "P06",
   "y_top": 7812,
   "y_bottom": 7900,
   "segment": "004.webp",
   "seg_y": 1498
  },
  {
   "i": 8,
   "who": "taeo",
   "type": "shout",
   "text": "NIB!",
   "panel_id": "P07",
   "y_top": 8032,
   "y_bottom": 8209,
   "segment": "004.webp",
   "seg_y": 1807
  },
  {
   "i": 9,
   "who": "nib",
   "type": "speech",
   "text": "YOU'RE LATE.",
   "panel_id": "P08",
   "y_top": 9876,
   "y_bottom": 9974,
   "segment": "005.webp",
   "seg_y": 208
  },
  {
   "i": 10,
   "who": "taeo",
   "type": "intense",
   "text": "YOU DIDN'T LEAVE A NOTE!",
   "panel_id": "P08",
   "y_top": 9992,
   "y_bottom": 10209,
   "segment": "005.webp",
   "seg_y": 443
  },
  {
   "i": 11,
   "who": "nib",
   "type": "speech",
   "text": "I FOLDED THE BLANKET.",
   "panel_id": "P08",
   "y_top": 10719,
   "y_bottom": 10941,
   "segment": "005.webp",
   "seg_y": 1175
  },
  {
   "i": 12,
   "who": "seonhee",
   "type": "speech",
   "text": "YOU HAVE TOOTHPASTE ON YOUR FACE.",
   "panel_id": "P09",
   "y_top": 11084,
   "y_bottom": 11372,
   "segment": "005.webp",
   "seg_y": 1606
  },
  {
   "i": 13,
   "who": "taeo",
   "type": "nervous",
   "text": "SORRY. GOOD MORNING.",
   "panel_id": "P09",
   "y_top": 11394,
   "y_bottom": 11610,
   "segment": "005.webp",
   "seg_y": 1844
  },
  {
   "i": 14,
   "who": "minho",
   "type": "speech",
   "text": "WHO'S SHOUTING?",
   "panel_id": "P10",
   "y_top": 11757,
   "y_bottom": 11911,
   "segment": "005.webp",
   "seg_y": 2145
  },
  {
   "i": 15,
   "who": "nib",
   "type": "speech",
   "text": "TAEO.",
   "panel_id": "P10",
   "y_top": 11929,
   "y_bottom": 12016,
   "segment": "005.webp",
   "seg_y": 2250
  },
  {
   "i": 16,
   "who": "nib",
   "type": "speech",
   "text": "I WANT THE GATE ON CHAE'S LIST. THE ONE WITH WHITE STONE.",
   "panel_id": "P11",
   "y_top": 12762,
   "y_bottom": 12983,
   "segment": "006.webp",
   "seg_y": 331
  },
  {
   "i": 17,
   "who": "minho",
   "type": "speech",
   "text": "THE LINE 6 TUNNEL. CHAE CALLED. RYU WON THE SURVEY CONTRACT.",
   "panel_id": "P11",
   "y_top": 13001,
   "y_bottom": 13223,
   "segment": "006.webp",
   "seg_y": 571
  },
  {
   "i": 18,
   "who": "minho",
   "type": "speech",
   "text": "E-GRADE. WE GO IN AT TEN.",
   "panel_id": "P11",
   "y_top": 13732,
   "y_bottom": 13954,
   "segment": "006.webp",
   "seg_y": 1302
  },
  {
   "i": 19,
   "who": "seonhee",
   "type": "speech",
   "text": "MINHO BID LOW FOR THAT SURVEY.",
   "panel_id": "P12",
   "y_top": 14060,
   "y_bottom": 14349,
   "segment": "006.webp",
   "seg_y": 1697
  },
  {
   "i": 20,
   "who": "minho",
   "type": "speech",
   "text": "MUM. WE BID LOW FOR EVERYTHING.",
   "panel_id": "P12",
   "y_top": 14371,
   "y_bottom": 14659,
   "segment": "006.webp",
   "seg_y": 2007
  },
  {
   "i": 21,
   "who": "minho",
   "type": "speech",
   "text": "SPOTTER. YOU WALK AHEAD, YOU LOOK, YOU TELL US.",
   "panel_id": "P14",
   "y_top": 15483,
   "y_bottom": 15704,
   "segment": "007.webp",
   "seg_y": 627
  },
  {
   "i": 22,
   "who": "minho",
   "type": "speech",
   "text": "₩60,000 FOR THE DAY.",
   "panel_id": "P14",
   "y_top": 15722,
   "y_bottom": 15944,
   "segment": "007.webp",
   "seg_y": 867
  },
  {
   "i": 23,
   "who": "minho",
   "type": "speech",
   "text": "THE SUBWAY COMPANY HIRES A CLEAR TEAM. THAT TEAM PAYS US TO MAP THE GATE FIRST.",
   "panel_id": "P15",
   "y_top": 16679,
   "y_bottom": 16967,
   "segment": "007.webp",
   "seg_y": 1890
  },
  {
   "i": 24,
   "who": "minho",
   "type": "speech",
   "text": "WE PAY YOU.",
   "panel_id": "P15",
   "y_top": 16985,
   "y_bottom": 17080,
   "segment": "007.webp",
   "seg_y": 2003
  },
  {
   "i": 25,
   "who": "nib",
   "type": "speech",
   "text": "AND WHO DO I PAY?",
   "panel_id": "P15",
   "y_top": 17711,
   "y_bottom": 17866,
   "segment": "007.webp",
   "seg_y": 2789
  },
  {
   "i": 26,
   "who": "minho",
   "type": "speech",
   "text": "NOBODY.",
   "panel_id": "P16",
   "y_top": 18140,
   "y_bottom": 18227,
   "segment": "008.webp",
   "seg_y": 255
  },
  {
   "i": 27,
   "who": "minho",
   "type": "speech",
   "text": "YOU GO FIRST.",
   "panel_id": "P16",
   "y_top": 18249,
   "y_bottom": 18403,
   "segment": "008.webp",
   "seg_y": 431
  },
  {
   "i": 28,
   "who": "taeo",
   "type": "speech",
   "text": "SIXTY THOUSAND FOR A WHOLE DAY? I MAKE MORE STACKING NOODLES.",
   "panel_id": "P17",
   "y_top": 18682,
   "y_bottom": 18903,
   "segment": "008.webp",
   "seg_y": 931
  },
  {
   "i": 29,
   "who": "nib",
   "type": "speech",
   "text": "I CAN COUNT.",
   "panel_id": "P17",
   "y_top": 18921,
   "y_bottom": 19076,
   "segment": "008.webp",
   "seg_y": 1104
  },
  {
   "i": 30,
   "who": "nib",
   "type": "speech",
   "text": "₩60,000. THREE YARD JOBS.",
   "panel_id": "P17",
   "y_top": 19633,
   "y_bottom": 19787,
   "segment": "008.webp",
   "seg_y": 1815
  },
  {
   "i": 31,
   "who": "seonhee",
   "type": "speech",
   "text": "NIB'S JOB INCLUDES INSURANCE. DOKGO'S PORTERS GET ₩90,000 WITHOUT IT.",
   "panel_id": "P18",
   "y_top": 19919,
   "y_bottom": 20208,
   "segment": "008.webp",
   "seg_y": 2236
  },
  {
   "i": 32,
   "who": "seonhee",
   "type": "speech",
   "text": "BREAK A LEG ON A DOKGO JOB AND YOU PAY FOR TREATMENT.",
   "panel_id": "P18",
   "y_top": 20226,
   "y_bottom": 20447,
   "segment": "008.webp",
   "seg_y": 2475
  },
  {
   "i": 33,
   "who": "taeo",
   "type": "float",
   "text": "TWO WEEKS OF EUNCHAE'S FLASHCARDS.",
   "panel_id": "P19",
   "y_top": 21145,
   "y_bottom": 21233,
   "segment": "009.webp",
   "seg_y": 198
  },
  {
   "i": 34,
   "who": "taeo",
   "type": "speech",
   "text": "AND ME?",
   "panel_id": "P20",
   "y_top": 21692,
   "y_bottom": 21778,
   "segment": "009.webp",
   "seg_y": 743
  },
  {
   "i": 35,
   "who": "minho",
   "type": "speech",
   "text": "AND YOU. HAEIN RUNS THE RADIO TABLE OUTSIDE THE GATE.",
   "panel_id": "P20",
   "y_top": 21728,
   "y_bottom": 21949,
   "segment": "009.webp",
   "seg_y": 914
  },
  {
   "i": 36,
   "who": "minho",
   "type": "speech",
   "text": "SIT WITH HER. LEARN. UNPAID.",
   "panel_id": "P20",
   "y_top": 22482,
   "y_bottom": 22637,
   "segment": "009.webp",
   "seg_y": 1602
  },
  {
   "i": 37,
   "who": "taeo",
   "type": "speech",
   "text": "UNPAID IS FINE.",
   "panel_id": "P21",
   "y_top": 22769,
   "y_bottom": 22923,
   "segment": "009.webp",
   "seg_y": 1888
  },
  {
   "i": 38,
   "who": "nib",
   "type": "speech",
   "text": "WORK SHOULD BE PAID.",
   "panel_id": "P21",
   "y_top": 22833,
   "y_bottom": 23054,
   "segment": "009.webp",
   "seg_y": 2019
  },
  {
   "i": 39,
   "who": "minho",
   "type": "speech",
   "text": "HE'S TRAINING. I'LL PAY HIM WHEN HE CAN DO THE JOB.",
   "panel_id": "P21",
   "y_top": 23563,
   "y_bottom": 23785,
   "segment": "009.webp",
   "seg_y": 2750
  },
  {
   "i": 40,
   "who": "dongsik",
   "type": "speech",
   "text": "WAITING'S THE JOB, SON.",
   "panel_id": "P22",
   "y_top": 23958,
   "y_bottom": 24180,
   "segment": "010.webp",
   "seg_y": 289
  },
  {
   "i": 41,
   "who": "dongsik",
   "type": "speech",
   "text": "NOBODY PAYS FOR IT.",
   "panel_id": "P22",
   "y_top": 24202,
   "y_bottom": 24424,
   "segment": "010.webp",
   "seg_y": 533
  },
  {
   "i": 42,
   "who": "sejin",
   "type": "speech",
   "text": "THEY PAY ME.",
   "panel_id": "P23",
   "y_top": 24601,
   "y_bottom": 24755,
   "segment": "010.webp",
   "seg_y": 864
  },
  {
   "i": 43,
   "who": "sejin",
   "type": "speech",
   "text": "₩300,000 FOR THE DAY. I WAIT AT THE GATE ENTRANCE.",
   "panel_id": "P24",
   "y_top": 25530,
   "y_bottom": 25751,
   "segment": "011.webp",
   "seg_y": 331
  },
  {
   "i": 44,
   "who": "sejin",
   "type": "speech",
   "text": "₩600,000 IF I ENTER. AND I'M HOME BY SIX.",
   "panel_id": "P24",
   "y_top": 25769,
   "y_bottom": 25991,
   "segment": "011.webp",
   "seg_y": 571
  },
  {
   "i": 45,
   "who": "seonhee",
   "type": "speech",
   "text": "BANK TRANSFER?",
   "panel_id": "P24",
   "y_top": 26524,
   "y_bottom": 26678,
   "segment": "011.webp",
   "seg_y": 1258
  },
  {
   "i": 46,
   "who": "seonhee",
   "type": "speech",
   "text": "THE INSURER WANTS A MEDICAL FOR EVERY ENTRANT.",
   "panel_id": "P25",
   "y_top": 26847,
   "y_bottom": 27069,
   "segment": "011.webp",
   "seg_y": 1649
  },
  {
   "i": 47,
   "who": "seonhee",
   "type": "speech",
   "text": "DOES NIB NEED AN EXAM TOO? HE'S SUMMONED.",
   "panel_id": "P25",
   "y_top": 27087,
   "y_bottom": 27308,
   "segment": "011.webp",
   "seg_y": 1888
  },
  {
   "i": 48,
   "who": "sejin",
   "type": "speech",
   "text": "SUMMONED IS NOT A DIAGNOSIS.",
   "panel_id": "P25",
   "y_top": 27817,
   "y_bottom": 28039,
   "segment": "011.webp",
   "seg_y": 2619
  },
  {
   "i": 49,
   "who": "sejin",
   "type": "speech",
   "text": "SAY 'AH'.",
   "panel_id": "P26",
   "y_top": 28347,
   "y_bottom": 28434,
   "segment": "011.webp",
   "seg_y": 3014
  },
  {
   "i": 50,
   "who": "nib",
   "type": "speech",
   "text": "YOU FIRST.",
   "panel_id": "P26",
   "y_top": 28456,
   "y_bottom": 28542,
   "segment": "011.webp",
   "seg_y": 3122
  },
  {
   "i": 51,
   "who": "sejin",
   "type": "speech",
   "text": "AH.",
   "panel_id": "P27",
   "y_top": 29031,
   "y_bottom": 29118,
   "segment": "012.webp",
   "seg_y": 373
  },
  {
   "i": 52,
   "who": "nib",
   "type": "speech",
   "text": "AH.",
   "panel_id": "P27",
   "y_top": 29140,
   "y_bottom": 29226,
   "segment": "012.webp",
   "seg_y": 481
  },
  {
   "i": 53,
   "who": "sejin",
   "type": "speech",
   "text": "WHO STITCHED THESE SCARS?",
   "panel_id": "P28",
   "y_top": 29539,
   "y_bottom": 29693,
   "segment": "012.webp",
   "seg_y": 948
  },
  {
   "i": 54,
   "who": "nib",
   "type": "speech",
   "text": "I DID.",
   "panel_id": "P28",
   "y_top": 29603,
   "y_bottom": 29689,
   "segment": "012.webp",
   "seg_y": 944
  },
  {
   "i": 55,
   "who": "sejin",
   "type": "speech",
   "text": "BADLY.",
   "panel_id": "P28",
   "y_top": 30274,
   "y_bottom": 30360,
   "segment": "012.webp",
   "seg_y": 1615
  },
  {
   "i": 56,
   "who": "nib",
   "type": "speech",
   "text": "THERE WAS NOBODY ELSE.",
   "panel_id": "P29",
   "y_top": 30492,
   "y_bottom": 30646,
   "segment": "012.webp",
   "seg_y": 1901
  },
  {
   "i": 57,
   "who": "sejin",
   "type": "speech",
   "text": "NEXT TIME, THERE'S ME.",
   "panel_id": "P29",
   "y_top": 30556,
   "y_bottom": 30710,
   "segment": "012.webp",
   "seg_y": 1965
  },
  {
   "i": 58,
   "who": "sejin",
   "type": "speech",
   "text": "₩300,000 A DAY.",
   "panel_id": "P29",
   "y_top": 31267,
   "y_bottom": 31421,
   "segment": "012.webp",
   "seg_y": 2676
  },
  {
   "i": 59,
   "who": "minho",
   "type": "speech",
   "text": "NEW ENTRANTS WATCH THE FILM. GMA RULES.",
   "panel_id": "P30",
   "y_top": 31849,
   "y_bottom": 32070,
   "segment": "013.webp",
   "seg_y": 285
  },
  {
   "i": 60,
   "who": "haein",
   "type": "speech",
   "text": "AGAIN? DAD, TELL HIM.",
   "panel_id": "P30",
   "y_top": 32088,
   "y_bottom": 32310,
   "segment": "013.webp",
   "seg_y": 525
  },
  {
   "i": 61,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "HELLO, NEW ENTRANTS! CROSS INTO A GATE AND YOU GET A RETURN MARK!",
   "panel_id": "P31",
   "y_top": 33061,
   "y_bottom": 33334,
   "segment": "013.webp",
   "seg_y": 1549
  },
  {
   "i": 62,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "ONE MARK PER PERSON. ONE USE. RETURN JOURNEYS ONLY!",
   "panel_id": "P31",
   "y_top": 33352,
   "y_bottom": 33626,
   "segment": "013.webp",
   "seg_y": 1841
  },
  {
   "i": 63,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "WHEN THE BOSS DIES, THE RIM FLASHES. NO ONE ELSE CAN ENTER.",
   "panel_id": "P32",
   "y_top": 34319,
   "y_bottom": 34541,
   "segment": "014.webp",
   "seg_y": 332
  },
  {
   "i": 64,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "IF YOU'RE CONSCIOUS, PRESS YOUR MARK TO RETURN IMMEDIATELY!",
   "panel_id": "P32",
   "y_top": 34559,
   "y_bottom": 34799,
   "segment": "014.webp",
   "seg_y": 590
  },
  {
   "i": 65,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "AFTER THE BOSS DIES, YOUR MARK RETURNS YOU AUTOMATICALLY IN THIRTY SECONDS. EVEN IF YOU'RE UNCONSCIOUS!",
   "panel_id": "P33",
   "y_top": 36445,
   "y_bottom": 36782,
   "segment": "015.webp",
   "seg_y": 447
  },
  {
   "i": 66,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "YOUR WORN AND CARRIED GEAR COMES WITH YOU!",
   "panel_id": "P33",
   "y_top": 36800,
   "y_bottom": 37009,
   "segment": "015.webp",
   "seg_y": 674
  },
  {
   "i": 67,
   "who": "crowd",
   "type": "speech",
   "text": "WEARING OR CARRYING.",
   "panel_id": "P34",
   "y_top": 37764,
   "y_bottom": 37986,
   "segment": "015.webp",
   "seg_y": 1651
  },
  {
   "i": 68,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "MARKS DO NOT HEAL! MARKS DO NOT REVIVE!",
   "panel_id": "P35",
   "y_top": 38350,
   "y_bottom": 38559,
   "segment": "015.webp",
   "seg_y": 2224
  },
  {
   "i": 69,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "DUNGEON NATIVES WHO NEVER CROSSED HAVE NO MARK. THEY STAY INSIDE!",
   "panel_id": "P35",
   "y_top": 38577,
   "y_bottom": 38850,
   "segment": "015.webp",
   "seg_y": 2515
  },
  {
   "i": 70,
   "who": "offpanel:psa",
   "type": "phone",
   "text": "STAY SAFE OUT THERE!",
   "panel_id": "P35",
   "y_top": 39434,
   "y_bottom": 39580,
   "segment": "015.webp",
   "seg_y": 3245
  },
  {
   "i": 71,
   "who": "nib",
   "type": "speech",
   "text": "I WAS BORN ON THE OTHER SIDE.",
   "panel_id": "P37",
   "y_top": 40129,
   "y_bottom": 40283,
   "segment": "016.webp",
   "seg_y": 597
  },
  {
   "i": 72,
   "who": "sejin",
   "type": "speech",
   "text": "YOU'RE ENTERING FROM SEOUL. YOU GET A RETURN MARK.",
   "panel_id": "P37",
   "y_top": 40301,
   "y_bottom": 40523,
   "segment": "016.webp",
   "seg_y": 837
  },
  {
   "i": 73,
   "who": "minho",
   "type": "speech",
   "text": "YOU WAIT FOR A CLEAR TEAM TO KILL THE BOSS.",
   "panel_id": "P40",
   "y_top": 41195,
   "y_bottom": 41618,
   "segment": "017.webp",
   "seg_y": 507
  },
  {
   "i": 74,
   "who": "dongsik",
   "type": "speech",
   "text": "I WAITED NINE HOURS FOR MY CLEAR TEAM.",
   "panel_id": "P40",
   "y_top": 41640,
   "y_bottom": 41996,
   "segment": "017.webp",
   "seg_y": 884
  },
  {
   "i": 75,
   "who": "taeo",
   "type": "speech",
   "text": "WHAT IF THIS GATE HAS THE SAME WHITE STONE AS YOUR POST?",
   "panel_id": "P41",
   "y_top": 42402,
   "y_bottom": 42623,
   "segment": "017.webp",
   "seg_y": 1512
  },
  {
   "i": 76,
   "who": "nib",
   "type": "speech",
   "text": "THEN I'LL KNOW WHERE TO LOOK.",
   "panel_id": "P41",
   "y_top": 42641,
   "y_bottom": 42795,
   "segment": "017.webp",
   "seg_y": 1684
  },
  {
   "i": 77,
   "who": "gma_warden",
   "type": "speech",
   "text": "TWO ENTRANTS. TWO CONSTRUCTS.",
   "panel_id": "P43",
   "y_top": 44670,
   "y_bottom": 44824,
   "segment": "019.webp",
   "seg_y": 264
  },
  {
   "i": 78,
   "who": "gma_warden",
   "type": "speech",
   "text": "WAIT. NIB. REGISTERED ARRIVAL. PERSON.",
   "panel_id": "P43",
   "y_top": 44842,
   "y_bottom": 45064,
   "segment": "019.webp",
   "seg_y": 504
  },
  {
   "i": 79,
   "who": "gma_warden",
   "type": "speech",
   "text": "THREE ENTRANTS. ONE CONSTRUCT.",
   "panel_id": "P43",
   "y_top": 45597,
   "y_bottom": 45751,
   "segment": "019.webp",
   "seg_y": 1191
  },
  {
   "i": 80,
   "who": "haein",
   "type": "speech",
   "text": "THE MULE FOLLOWS THE SPOTTER. ITS SUMMONER LEASES IT TO US. ₩30,000 A MONTH.",
   "panel_id": "P44",
   "y_top": 45883,
   "y_bottom": 46171,
   "segment": "019.webp",
   "seg_y": 1611
  },
  {
   "i": 81,
   "who": "nib",
   "type": "speech",
   "text": "I'M TWO MONTHS OF MULE.",
   "panel_id": "P44",
   "y_top": 46189,
   "y_bottom": 46411,
   "segment": "019.webp",
   "seg_y": 1851
  },
  {
   "i": 82,
   "who": "taeo",
   "type": "speech",
   "text": "PLEASE DON'T PUT IT LIKE THAT.",
   "panel_id": "P44",
   "y_top": 46944,
   "y_bottom": 47098,
   "segment": "019.webp",
   "seg_y": 2538
  },
  {
   "i": 83,
   "who": "offpanel:minho",
   "type": "speech",
   "text": "BOOTS. IT'S STONE IN THERE.",
   "panel_id": "P45",
   "y_top": 47453,
   "y_bottom": 47607,
   "segment": "020.webp",
   "seg_y": 403
  },
  {
   "i": 84,
   "who": "nib",
   "type": "speech",
   "text": "NO.",
   "panel_id": "P45",
   "y_top": 47629,
   "y_bottom": 47715,
   "segment": "020.webp",
   "seg_y": 511
  },
  {
   "i": 85,
   "who": "sejin",
   "type": "speech",
   "text": "LET NIB GO BAREFOOT. HIS FEET ARE BETTER THAN YOUR BOOTS.",
   "panel_id": "P46",
   "y_top": 48370,
   "y_bottom": 48592,
   "segment": "020.webp",
   "seg_y": 1388
  },
  {
   "i": 86,
   "who": "taeo",
   "type": "float",
   "text": "₩60,000 FOR NIB TO SCOUT. ₩300,000 FOR SEJIN TO WAIT.",
   "panel_id": "P46",
   "y_top": 48610,
   "y_bottom": 48697,
   "segment": "020.webp",
   "seg_y": 1493
  },
  {
   "i": 87,
   "who": "taeo",
   "type": "float",
   "text": "AND NOTHING TO HOLD THE CLIPBOARD.",
   "panel_id": "P46",
   "y_top": 49449,
   "y_bottom": 49537,
   "segment": "020.webp",
   "seg_y": 2333
  },
  {
   "i": 88,
   "who": "haein",
   "type": "speech",
   "text": "THE RADIO SIGNAL DIES AT THE GATE'S EDGE. LIKE ALWAYS.",
   "panel_id": "P48",
   "y_top": 50420,
   "y_bottom": 50641,
   "segment": "021.webp",
   "seg_y": 331
  },
  {
   "i": 89,
   "who": "minho",
   "type": "speech",
   "text": "FIRST LEG, FORTY MINUTES. THEN WE COME OUT AND REPORT.",
   "panel_id": "P48",
   "y_top": 50659,
   "y_bottom": 50881,
   "segment": "021.webp",
   "seg_y": 571
  },
  {
   "i": 90,
   "who": "nib",
   "type": "speech",
   "text": "I DON'T HAVE A WATCH.",
   "panel_id": "P48",
   "y_top": 51390,
   "y_bottom": 51612,
   "segment": "021.webp",
   "seg_y": 1302
  },
  {
   "i": 91,
   "who": "taeo",
   "type": "speech",
   "text": "NIB WILL BE AHEAD OF EVERYONE.",
   "panel_id": "P49",
   "y_top": 51744,
   "y_bottom": 51966,
   "segment": "021.webp",
   "seg_y": 1656
  },
  {
   "i": 92,
   "who": "taeo",
   "type": "float",
   "text": "I WANTED SOMETHING TO COME BACK. EVEN A SOUND.",
   "panel_id": "P49",
   "y_top": 51984,
   "y_bottom": 52071,
   "segment": "021.webp",
   "seg_y": 1761
  },
  {
   "i": 93,
   "who": "sejin",
   "type": "speech",
   "text": "YOU CAN HEAR THROUGH THE GATE. IF YOU'RE CLOSE ENOUGH.",
   "panel_id": "P50",
   "y_top": 53817,
   "y_bottom": 54039,
   "segment": "022.webp",
   "seg_y": 332
  },
  {
   "i": 94,
   "who": "taeo",
   "type": "speech",
   "text": "THEN TWO KNOCKS FROM OUT HERE MEAN 'COME BACK'.",
   "panel_id": "P50",
   "y_top": 54057,
   "y_bottom": 54278,
   "segment": "022.webp",
   "seg_y": 571
  },
  {
   "i": 95,
   "who": "taeo",
   "type": "speech",
   "text": "AND THREE FROM INSIDE MEAN 'COMING'.",
   "panel_id": "P50",
   "y_top": 54787,
   "y_bottom": 55008,
   "segment": "022.webp",
   "seg_y": 1301
  },
  {
   "i": 96,
   "who": "nib",
   "type": "speech",
   "text": "KNOCK-KNOCK. LIKE YOUR TALKING APP.",
   "panel_id": "P51",
   "y_top": 55140,
   "y_bottom": 55295,
   "segment": "022.webp",
   "seg_y": 1588
  },
  {
   "i": 97,
   "who": "taeo",
   "type": "speech",
   "text": "LIKE TTOK. YES.",
   "panel_id": "P51",
   "y_top": 55313,
   "y_bottom": 55467,
   "segment": "022.webp",
   "seg_y": 1760
  },
  {
   "i": 98,
   "who": "minho",
   "type": "speech",
   "text": "FINE. AFTER FORTY MINUTES INSIDE, WE'LL RETURN. KNOCK IF WE'RE NOT BACK.",
   "panel_id": "P51",
   "y_top": 55995,
   "y_bottom": 56284,
   "segment": "022.webp",
   "seg_y": 2576
  },
  {
   "i": 99,
   "who": "taeo",
   "type": "speech",
   "text": "DON'T TOUCH ANYTHING THAT GLOWS. CHECK THE FLOOR. IF SOMETHING MOVES, COME BACK.",
   "panel_id": "P52",
   "y_top": 56416,
   "y_bottom": 56704,
   "segment": "023.webp",
   "seg_y": 349
  },
  {
   "i": 100,
   "who": "nib",
   "type": "speech",
   "text": "TAEO. TWO KNOCKS, I COME BACK. THREE, I'M COMING.",
   "panel_id": "P52",
   "y_top": 56722,
   "y_bottom": 56944,
   "segment": "023.webp",
   "seg_y": 589
  },
  {
   "i": 101,
   "who": "taeo",
   "type": "speech",
   "text": "YES. SORRY.",
   "panel_id": "P52",
   "y_top": 57501,
   "y_bottom": 57589,
   "segment": "023.webp",
   "seg_y": 1234
  },
  {
   "i": 102,
   "who": "minho",
   "type": "speech",
   "text": "SPOTTER FIRST.",
   "panel_id": "P53",
   "y_top": 57721,
   "y_bottom": 57875,
   "segment": "023.webp",
   "seg_y": 1520
  },
  {
   "i": 103,
   "who": "nib",
   "type": "speech",
   "text": "I KNOW.",
   "panel_id": "P53",
   "y_top": 57785,
   "y_bottom": 57871,
   "segment": "023.webp",
   "seg_y": 1516
  },
  {
   "i": 104,
   "who": "minho",
   "type": "speech",
   "text": "HAEIN STARTS THE CLOCK WHEN YOU CROSS.",
   "panel_id": "P53",
   "y_top": 58461,
   "y_bottom": 58682,
   "segment": "023.webp",
   "seg_y": 2327
  }
 ],

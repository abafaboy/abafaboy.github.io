 "lines": [
  {
   "i": 1,
   "who": "taeo",
   "type": "float",
   "text": "GRANDPA SAYS \"IT'S FINE\" ABOUT EVERYTHING.",
   "panel_id": "P01",
   "y_top": 26,
   "y_bottom": 113,
   "segment": "001.webp",
   "seg_y": 113
  },
  {
   "i": 2,
   "who": "taeo",
   "type": "float",
   "text": "HE TOLD ME NEVER TO ENTER A GATE.",
   "panel_id": "P01",
   "y_top": 131,
   "y_bottom": 219,
   "segment": "001.webp",
   "seg_y": 219
  },
  {
   "i": 3,
   "who": "nib",
   "type": "speech",
   "text": "YOUR GRANDPA SAID SOMETHING. AT THE BUS DOOR.",
   "panel_id": "P02",
   "y_top": 1065,
   "y_bottom": 1286,
   "segment": "001.webp",
   "seg_y": 1286
  },
  {
   "i": 4,
   "who": "taeo",
   "type": "speech",
   "text": "IT WAS NOTHING.",
   "panel_id": "P02",
   "y_top": 1157,
   "y_bottom": 1311,
   "segment": "001.webp",
   "seg_y": 1311
  },
  {
   "i": 5,
   "who": "taeo",
   "type": "float",
   "text": "TWENTY DAYS UNTIL THEY DECIDE WHAT NIB IS.",
   "panel_id": "P04",
   "y_top": 2662,
   "y_bottom": 2787,
   "segment": "001.webp",
   "seg_y": 2787
  },
  {
   "i": 6,
   "who": "nib",
   "type": "speech",
   "text": "LAST SCREEN. ITS METAL FOOT IS BENT. THE SCREEN WILL TIP.",
   "panel_id": "P06",
   "y_top": 5250,
   "y_bottom": 5472,
   "segment": "002.webp",
   "seg_y": 2448
  },
  {
   "i": 7,
   "who": "taeo",
   "type": "float",
   "text": "I GOT VERY GOOD AT WATCHING.",
   "panel_id": "P06",
   "y_top": 5490,
   "y_bottom": 5577,
   "segment": "002.webp",
   "seg_y": 2553
  },
  {
   "i": 8,
   "who": "eunchae",
   "type": "speech",
   "text": "AGAIN. READ YOUR NAME.",
   "panel_id": "P08",
   "y_top": 7403,
   "y_bottom": 7557,
   "segment": "003.webp",
   "seg_y": 1160
  },
  {
   "i": 9,
   "who": "nib",
   "type": "speech",
   "text": "NIB.",
   "panel_id": "P08",
   "y_top": 7467,
   "y_bottom": 7554,
   "segment": "003.webp",
   "seg_y": 1157
  },
  {
   "i": 10,
   "who": "nib",
   "type": "speech",
   "text": "CROSS... CONTAMINATION.",
   "panel_id": "P09",
   "y_top": 8320,
   "y_bottom": 8474,
   "segment": "003.webp",
   "seg_y": 2077
  },
  {
   "i": 11,
   "who": "eunchae",
   "type": "speech",
   "text": "WRONG PILE. THAT'S MY EXAM CARD.",
   "panel_id": "P09",
   "y_top": 8496,
   "y_bottom": 8786,
   "segment": "003.webp",
   "seg_y": 2389
  },
  {
   "i": 12,
   "who": "taeo",
   "type": "float",
   "text": "NIGHTS WENT TO THE UNIT. I GOT WEEKENDS.",
   "panel_id": "P10",
   "y_top": 9259,
   "y_bottom": 9346,
   "segment": "004.webp",
   "seg_y": 493
  },
  {
   "i": 13,
   "who": "taeo",
   "type": "speech",
   "text": "MORNING.",
   "panel_id": "P10",
   "y_top": 9364,
   "y_bottom": 9451,
   "segment": "004.webp",
   "seg_y": 598
  },
  {
   "i": 14,
   "who": "nib",
   "type": "speech",
   "text": "WHO TAKES OVER FROM THE STOCKER?",
   "panel_id": "P11",
   "y_top": 10250,
   "y_bottom": 10472,
   "segment": "005.webp",
   "seg_y": 332
  },
  {
   "i": 15,
   "who": "taeo",
   "type": "speech",
   "text": "NOBODY. THE CONSTRUCT DOESN'T GET TIRED.",
   "panel_id": "P11",
   "y_top": 10490,
   "y_bottom": 10779,
   "segment": "005.webp",
   "seg_y": 639
  },
  {
   "i": 16,
   "who": "nib",
   "type": "speech",
   "text": "THEN NOBODY COMES FOR IT.",
   "panel_id": "P11",
   "y_top": 11307,
   "y_bottom": 11461,
   "segment": "005.webp",
   "seg_y": 1321
  },
  {
   "i": 17,
   "who": "taeo",
   "type": "float",
   "text": "I WROTE DOWN EVERYTHING I'D SAY FOR HIM.",
   "panel_id": "P12",
   "y_top": 11889,
   "y_bottom": 12014,
   "segment": "005.webp",
   "seg_y": 1874
  },
  {
   "i": 18,
   "who": "nib",
   "type": "speech",
   "text": "THE PANEL WILL ASK ME.",
   "panel_id": "P12",
   "y_top": 12032,
   "y_bottom": 12186,
   "segment": "005.webp",
   "seg_y": 2046
  },
  {
   "i": 19,
   "who": "taeo",
   "type": "nervous",
   "text": "SORRY. HE'S ATTACHED TO HIS KNIFE.",
   "panel_id": "P15",
   "y_top": 14905,
   "y_bottom": 15120,
   "segment": "007.webp",
   "seg_y": 325
  },
  {
   "i": 20,
   "who": "guard",
   "type": "speech",
   "text": "YOU'LL GET YOUR KNIFE BACK ON THE WAY OUT.",
   "panel_id": "P15",
   "y_top": 14995,
   "y_bottom": 15216,
   "segment": "007.webp",
   "seg_y": 421
  },
  {
   "i": 21,
   "who": "nib",
   "type": "speech",
   "text": "IT'S A GOOD KNIFE. DON'T DROP IT.",
   "panel_id": "P15",
   "y_top": 15725,
   "y_bottom": 15947,
   "segment": "007.webp",
   "seg_y": 1152
  },
  {
   "i": 22,
   "who": "dr_pyo",
   "type": "speech",
   "text": "GOOD MORNING, NIB.",
   "panel_id": "P16",
   "y_top": 16079,
   "y_bottom": 16301,
   "segment": "007.webp",
   "seg_y": 1506
  },
  {
   "i": 23,
   "who": "taeo",
   "type": "nervous",
   "text": "M-MORNING.",
   "panel_id": "P16",
   "y_top": 16319,
   "y_bottom": 16469,
   "segment": "007.webp",
   "seg_y": 1674
  },
  {
   "i": 24,
   "who": "aao_supervisor",
   "type": "speech",
   "text": "WITHDRAW YOUR ARRIVAL REPORT, YURI. LET KANGHAN CLASSIFY NIB.",
   "panel_id": "P17",
   "y_top": 17192,
   "y_bottom": 17413,
   "segment": "008.webp",
   "seg_y": 331
  },
  {
   "i": 25,
   "who": "chae",
   "type": "speech",
   "text": "NIB ISN'T THEIRS.",
   "panel_id": "P17",
   "y_top": 17431,
   "y_bottom": 17586,
   "segment": "008.webp",
   "seg_y": 504
  },
  {
   "i": 26,
   "who": "aao_supervisor",
   "type": "speech",
   "text": "THEN YOU'LL HAVE TO DEFEND YOUR REPORT.",
   "panel_id": "P17",
   "y_top": 18119,
   "y_bottom": 18340,
   "segment": "008.webp",
   "seg_y": 1258
  },
  {
   "i": 27,
   "who": "chae",
   "type": "speech",
   "text": "MY NAME IS ALREADY ON THE REPORT.",
   "panel_id": "P18",
   "y_top": 18601,
   "y_bottom": 18890,
   "segment": "008.webp",
   "seg_y": 1808
  },
  {
   "i": 28,
   "who": "nib",
   "type": "whisper",
   "text": "ONE DOOR.",
   "panel_id": "P19",
   "y_top": 19452,
   "y_bottom": 19549,
   "segment": "008.webp",
   "seg_y": 2467
  },
  {
   "i": 29,
   "who": "taeo",
   "type": "whisper",
   "text": "I COUNTED TOO.",
   "panel_id": "P19",
   "y_top": 19567,
   "y_bottom": 19699,
   "segment": "008.webp",
   "seg_y": 2617
  },
  {
   "i": 30,
   "who": "chae",
   "type": "speech",
   "text": "THE 1995 ACT HAS AN ARRIVAL CATEGORY. NOBODY HAS USED IT IN TWENTY YEARS.",
   "panel_id": "P24",
   "y_top": 20899,
   "y_bottom": 21188,
   "segment": "009.webp",
   "seg_y": 732
  },
  {
   "i": 31,
   "who": "chae",
   "type": "speech",
   "text": "I FILED NIB IN THAT CATEGORY.",
   "panel_id": "P24",
   "y_top": 21206,
   "y_bottom": 21360,
   "segment": "009.webp",
   "seg_y": 904
  },
  {
   "i": 32,
   "who": "chae",
   "type": "speech",
   "text": "I SHOWED NIB THE FORM. TWO BOXES: HUNTER OR CONSTRUCT.",
   "panel_id": "P25",
   "y_top": 22056,
   "y_bottom": 22479,
   "segment": "010.webp",
   "seg_y": 507
  },
  {
   "i": 33,
   "who": "chae",
   "type": "speech",
   "text": "HE TOLD ME HE WASN'T A BOX.",
   "panel_id": "P25",
   "y_top": 22501,
   "y_bottom": 22723,
   "segment": "010.webp",
   "seg_y": 751
  },
  {
   "i": 34,
   "who": "minho",
   "type": "speech",
   "text": "NINE JOBS. ₩20,000 EACH. PAID TO NIB, NOT TO MR. YOON.",
   "panel_id": "P26",
   "y_top": 22833,
   "y_bottom": 23054,
   "segment": "010.webp",
   "seg_y": 1082
  },
  {
   "i": 35,
   "who": "panel_tech",
   "type": "speech",
   "text": "THAT PROVES HOW YOU PAID HIM. NOT WHAT HE IS.",
   "panel_id": "P26",
   "y_top": 23072,
   "y_bottom": 23294,
   "segment": "010.webp",
   "seg_y": 1322
  },
  {
   "i": 36,
   "who": "minho",
   "type": "speech",
   "text": "NIB TURNED DOWN A TENTH JOB.",
   "panel_id": "P27",
   "y_top": 24070,
   "y_bottom": 24292,
   "segment": "010.webp",
   "seg_y": 2320
  },
  {
   "i": 37,
   "who": "minho",
   "type": "speech",
   "text": "HE HAD A HANGUL LESSON.",
   "panel_id": "P27",
   "y_top": 24314,
   "y_bottom": 24536,
   "segment": "010.webp",
   "seg_y": 2564
  },
  {
   "i": 38,
   "who": "minho",
   "type": "speech",
   "text": "I ONLY VOUCH FOR WHAT I'VE SEEN.",
   "panel_id": "P28",
   "y_top": 24713,
   "y_bottom": 24935,
   "segment": "011.webp",
   "seg_y": 332
  },
  {
   "i": 39,
   "who": "minho",
   "type": "speech",
   "text": "I'VE SEEN NIB CHOOSE HIS OWN WORK.",
   "panel_id": "P28",
   "y_top": 24953,
   "y_bottom": 25174,
   "segment": "011.webp",
   "seg_y": 571
  },
  {
   "i": 40,
   "who": "courier",
   "type": "shout",
   "text": "SORRY! QUICKHAUL! I'M HERE!",
   "panel_id": "P29",
   "y_top": 25872,
   "y_bottom": 26197,
   "segment": "011.webp",
   "seg_y": 1594
  },
  {
   "i": 41,
   "who": "courier",
   "type": "speech",
   "text": "HE SAVED MY DELIVERY.",
   "panel_id": "P30",
   "y_top": 26890,
   "y_bottom": 27111,
   "segment": "011.webp",
   "seg_y": 2508
  },
  {
   "i": 42,
   "who": "panel_chair",
   "type": "speech",
   "text": "IS THAT YOUR WHOLE STATEMENT?",
   "panel_id": "P30",
   "y_top": 27129,
   "y_bottom": 27351,
   "segment": "011.webp",
   "seg_y": 2748
  },
  {
   "i": 43,
   "who": "courier",
   "type": "speech",
   "text": "I PAY ₩640,000 A MONTH FOR A CONSTRUCT.",
   "panel_id": "P31",
   "y_top": 28023,
   "y_bottom": 28378,
   "segment": "012.webp",
   "seg_y": 439
  },
  {
   "i": 44,
   "who": "courier",
   "type": "speech",
   "text": "I KNOW WHAT A CONSTRUCT IS. NIB ISN'T ONE.",
   "panel_id": "P31",
   "y_top": 28400,
   "y_bottom": 28756,
   "segment": "012.webp",
   "seg_y": 817
  },
  {
   "i": 45,
   "who": "panel_chair",
   "type": "speech",
   "text": "MR. YOON.",
   "panel_id": "P32",
   "y_top": 29162,
   "y_bottom": 29249,
   "segment": "012.webp",
   "seg_y": 1310
  },
  {
   "i": 46,
   "who": "panel_chair",
   "type": "speech",
   "text": "WHAT IS NIB?",
   "panel_id": "P32",
   "y_top": 29267,
   "y_bottom": 29421,
   "segment": "012.webp",
   "seg_y": 1482
  },
  {
   "i": 47,
   "who": "taeo",
   "type": "speech",
   "text": "YOU SHOULD ASK NIB.",
   "panel_id": "P34",
   "y_top": 30602,
   "y_bottom": 30756,
   "segment": "012.webp",
   "seg_y": 2817
  },
  {
   "i": 48,
   "who": "offpanel:panel_chair",
   "type": "speech",
   "text": "VERY WELL. THE LECTERN, PLEASE.",
   "panel_id": "P34",
   "y_top": 30778,
   "y_bottom": 31066,
   "segment": "012.webp",
   "seg_y": 3127
  },
  {
   "i": 49,
   "who": "offpanel:panel_chair",
   "type": "speech",
   "text": "COULD THE ARRIVAL STAND WHERE WE CAN SEE HIM?",
   "panel_id": "P35",
   "y_top": 31244,
   "y_bottom": 31466,
   "segment": "013.webp",
   "seg_y": 332
  },
  {
   "i": 50,
   "who": "nib",
   "type": "speech",
   "text": "HERE. I CAN SEE THE DOOR.",
   "panel_id": "P36",
   "y_top": 32217,
   "y_bottom": 32439,
   "segment": "013.webp",
   "seg_y": 1305
  },
  {
   "i": 51,
   "who": "panel_chair",
   "type": "speech",
   "text": "IS THE DOOR A PROBLEM?",
   "panel_id": "P36",
   "y_top": 32310,
   "y_bottom": 32532,
   "segment": "013.webp",
   "seg_y": 1398
  },
  {
   "i": 52,
   "who": "nib",
   "type": "speech",
   "text": "THERE'S ONLY ONE. I'M AFRAID IN ROOMS WITH ONE DOOR.",
   "panel_id": "P36",
   "y_top": 33994,
   "y_bottom": 34215,
   "segment": "013.webp",
   "seg_y": 3081
  },
  {
   "i": 53,
   "who": "panel_chair",
   "type": "speech",
   "text": "NOTED.",
   "panel_id": "P37",
   "y_top": 34490,
   "y_bottom": 34576,
   "segment": "014.webp",
   "seg_y": 255
  },
  {
   "i": 54,
   "who": "panel_chair",
   "type": "speech",
   "text": "WHAT ARE YOU?",
   "panel_id": "P37",
   "y_top": 34598,
   "y_bottom": 34753,
   "segment": "014.webp",
   "seg_y": 432
  },
  {
   "i": 55,
   "who": "nib",
   "type": "speech",
   "text": "A SCOUT.",
   "panel_id": "P38",
   "y_top": 35031,
   "y_bottom": 35118,
   "segment": "014.webp",
   "seg_y": 797
  },
  {
   "i": 56,
   "who": "nib",
   "type": "speech",
   "text": "I KEEP WATCH AT A WALL ABOVE THE LOWER PATH.",
   "panel_id": "P38",
   "y_top": 35136,
   "y_bottom": 35357,
   "segment": "014.webp",
   "seg_y": 1036
  },
  {
   "i": 57,
   "who": "offpanel:nib",
   "type": "speech",
   "text": "KETT WAS COMING TO TAKE OVER MY WATCH.",
   "panel_id": "P39",
   "y_top": 36055,
   "y_bottom": 36276,
   "segment": "014.webp",
   "seg_y": 1955
  },
  {
   "i": 58,
   "who": "offpanel:nib",
   "type": "speech",
   "text": "KETT WILL FIND MY POST EMPTY. HE'LL GO LOOKING.",
   "panel_id": "P40",
   "y_top": 37027,
   "y_bottom": 37248,
   "segment": "015.webp",
   "seg_y": 331
  },
  {
   "i": 59,
   "who": "nib",
   "type": "speech",
   "text": "I'M SOMEONE'S RELIEF.",
   "panel_id": "P41",
   "y_top": 37999,
   "y_bottom": 38221,
   "segment": "015.webp",
   "seg_y": 1304
  },
  {
   "i": 60,
   "who": "dr_pyo",
   "type": "speech",
   "text": "MIMICRY CAN BE VERY SOPHISTICATED.",
   "panel_id": "P44",
   "y_top": 40363,
   "y_bottom": 40651,
   "segment": "016.webp",
   "seg_y": 444
  },
  {
   "i": 61,
   "who": "nib",
   "type": "speech",
   "text": "THEN WHY WOULD I LIE ABOUT BEING AFRAID?",
   "panel_id": "P45",
   "y_top": 40917,
   "y_bottom": 41138,
   "segment": "016.webp",
   "seg_y": 931
  },
  {
   "i": 62,
   "who": "panel_chair",
   "type": "announce",
   "text": "KANGHAN'S PETITION IS DENIED.",
   "panel_id": "P47",
   "y_top": 42602,
   "y_bottom": 42821,
   "segment": "017.webp",
   "seg_y": 625
  },
  {
   "i": 63,
   "who": "panel_chair",
   "type": "announce",
   "text": "NIB IS A REGISTERED ARRIVAL. A PERSON. STATUS PENDING FOR TWELVE MONTHS, RENEWABLE.",
   "panel_id": "P47",
   "y_top": 42839,
   "y_bottom": 43175,
   "segment": "017.webp",
   "seg_y": 979
  },
  {
   "i": 64,
   "who": "taeo",
   "type": "float",
   "text": "I HADN'T BREATHED IN TWENTY DAYS.",
   "panel_id": "P48",
   "y_top": 43868,
   "y_bottom": 43956,
   "segment": "017.webp",
   "seg_y": 1760
  },
  {
   "i": 65,
   "who": "nib",
   "type": "speech",
   "text": "YOU'RE LEAKING.",
   "panel_id": "P48",
   "y_top": 43974,
   "y_bottom": 44128,
   "segment": "017.webp",
   "seg_y": 1932
  },
  {
   "i": 66,
   "who": "aao_supervisor",
   "type": "speech",
   "text": "YOUR ARRIVAL REPORT GOES IN YOUR STAFF REVIEW, YURI. WHATEVER THE RULING.",
   "panel_id": "P49",
   "y_top": 44903,
   "y_bottom": 45192,
   "segment": "018.webp",
   "seg_y": 399
  },
  {
   "i": 67,
   "who": "chae",
   "type": "speech",
   "text": "I KNOW.",
   "panel_id": "P49",
   "y_top": 45024,
   "y_bottom": 45110,
   "segment": "018.webp",
   "seg_y": 317
  },
  {
   "i": 68,
   "who": "aao_supervisor",
   "type": "speech",
   "text": "GOOD REPORT, THOUGH.",
   "panel_id": "P49",
   "y_top": 45696,
   "y_bottom": 45917,
   "segment": "018.webp",
   "seg_y": 1124
  },
  {
   "i": 69,
   "who": "clerk",
   "type": "speech",
   "text": "LOOK AT THE LENS. CAN YOU SMILE?",
   "panel_id": "P50",
   "y_top": 46345,
   "y_bottom": 46567,
   "segment": "018.webp",
   "seg_y": 1774
  },
  {
   "i": 70,
   "who": "nib",
   "type": "speech",
   "text": "NO.",
   "panel_id": "P50",
   "y_top": 46438,
   "y_bottom": 46525,
   "segment": "018.webp",
   "seg_y": 1732
  },
  {
   "i": 71,
   "who": "offpanel:nib",
   "type": "speech",
   "text": "LINKED... PARTNER.",
   "panel_id": "P51",
   "y_top": 47265,
   "y_bottom": 47420,
   "segment": "018.webp",
   "seg_y": 2627
  },
  {
   "i": 72,
   "who": "taeo",
   "type": "speech",
   "text": "YOU CAN READ THAT?",
   "panel_id": "P52",
   "y_top": 47896,
   "y_bottom": 48050,
   "segment": "019.webp",
   "seg_y": 268
  },
  {
   "i": 73,
   "who": "nib",
   "type": "speech",
   "text": "SLOWLY.",
   "panel_id": "P52",
   "y_top": 48072,
   "y_bottom": 48158,
   "segment": "019.webp",
   "seg_y": 376
  },
  {
   "i": 74,
   "who": "nib",
   "type": "speech",
   "text": "WHAT.",
   "panel_id": "P52",
   "y_top": 48180,
   "y_bottom": 48267,
   "segment": "019.webp",
   "seg_y": 485
  },
  {
   "i": 75,
   "who": "dr_pyo",
   "type": "speech",
   "text": "PENDING ISN'T PERMANENT, MR. YOON.",
   "panel_id": "P54",
   "y_top": 48621,
   "y_bottom": 48910,
   "segment": "019.webp",
   "seg_y": 1128
  },
  {
   "i": 76,
   "who": "chae",
   "type": "speech",
   "text": "THE ARCHIVE YOU SAW ONLY HAS OLD GATE SURVEYS.",
   "panel_id": "P56",
   "y_top": 50316,
   "y_bottom": 50537,
   "segment": "020.webp",
   "seg_y": 627
  },
  {
   "i": 77,
   "who": "chae",
   "type": "speech",
   "text": "THESE GATES ARE STILL OPEN TODAY.",
   "panel_id": "P56",
   "y_top": 50555,
   "y_bottom": 50777,
   "segment": "020.webp",
   "seg_y": 867
  },
  {
   "i": 78,
   "who": "chae",
   "type": "speech",
   "text": "THE TUNNEL GATE'S ENTRANCE SURVEY. I PRINTED THE PHOTO.",
   "panel_id": "P58",
   "y_top": 52159,
   "y_bottom": 52381,
   "segment": "020.webp",
   "seg_y": 2471
  },
  {
   "i": 79,
   "who": "chae",
   "type": "speech",
   "text": "YOU LIKE PAPER.",
   "panel_id": "P58",
   "y_top": 52399,
   "y_bottom": 52553,
   "segment": "020.webp",
   "seg_y": 2643
  },
  {
   "i": 80,
   "who": "nib",
   "type": "speech",
   "text": "THE WHITE STONE. LIKE THE WHITE BIT BY MY WALL.",
   "panel_id": "P60",
   "y_top": 53666,
   "y_bottom": 54022,
   "segment": "021.webp",
   "seg_y": 773
  },
  {
   "i": 81,
   "who": "offpanel:chae",
   "type": "speech",
   "text": "THE TUNNEL GATE IS STILL OPEN. FOR NOW.",
   "panel_id": "P60",
   "y_top": 54044,
   "y_bottom": 54333,
   "segment": "021.webp",
   "seg_y": 1084
  },
  {
   "i": 82,
   "who": "nib",
   "type": "speech",
   "text": "I WANT TO GO IN.",
   "panel_id": "P61",
   "y_top": 54443,
   "y_bottom": 54597,
   "segment": "021.webp",
   "seg_y": 1348
  },
  {
   "i": 83,
   "who": "taeo",
   "type": "float",
   "text": "GRANDPA'S WORDS: DON'T YOU EVER.",
   "panel_id": "P62",
   "y_top": 56414,
   "y_bottom": 56502,
   "segment": "022.webp",
   "seg_y": 256
  },
  {
   "i": 84,
   "who": "taeo",
   "type": "speech",
   "text": "I CAN'T GO IN.",
   "panel_id": "P62",
   "y_top": 56524,
   "y_bottom": 56678,
   "segment": "022.webp",
   "seg_y": 432
  },
  {
   "i": 85,
   "who": "nib",
   "type": "speech",
   "text": "I DIDN'T ASK YOU TO.",
   "panel_id": "P63",
   "y_top": 56956,
   "y_bottom": 57110,
   "segment": "022.webp",
   "seg_y": 864
  }
 ],

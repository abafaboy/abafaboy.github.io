 "lines": [
  {
   "i": 1,
   "who": "taeo",
   "type": "float",
   "text": "THREE HOURS ON THE BUS. I STILL DON'T KNOW HOW TO TELL MY FAMILY.",
   "panel_id": "P01",
   "y_top": 26,
   "y_bottom": 113,
   "segment": "001.webp",
   "seg_y": 113
  },
  {
   "i": 2,
   "who": "nib",
   "type": "speech",
   "text": "THAT DOOR IS OPEN.",
   "panel_id": "P02",
   "y_top": 1859,
   "y_bottom": 2013,
   "segment": "001.webp",
   "seg_y": 2013
  },
  {
   "i": 3,
   "who": "taeo",
   "type": "speech",
   "text": "THE SEA GATE NEVER CLOSES.",
   "panel_id": "P02",
   "y_top": 1923,
   "y_bottom": 2077,
   "segment": "001.webp",
   "seg_y": 2077
  },
  {
   "i": 4,
   "who": "nib",
   "type": "speech",
   "text": "WHO KEEPS WATCH ON THE SEA GATE?",
   "panel_id": "P03",
   "y_top": 2799,
   "y_bottom": 2954,
   "segment": "001.webp",
   "seg_y": 2954
  },
  {
   "i": 5,
   "who": "grandpa",
   "type": "speech",
   "text": "YOU'D BE NIB.",
   "panel_id": "P06",
   "y_top": 6262,
   "y_bottom": 6416,
   "segment": "003.webp",
   "seg_y": 264
  },
  {
   "i": 6,
   "who": "nib",
   "type": "speech",
   "text": "YES.",
   "panel_id": "P06",
   "y_top": 6326,
   "y_bottom": 6412,
   "segment": "003.webp",
   "seg_y": 260
  },
  {
   "i": 7,
   "who": "grandpa",
   "type": "speech",
   "text": "I'M TAEO'S GRANDFATHER. WELCOME.",
   "panel_id": "P06",
   "y_top": 6949,
   "y_bottom": 7171,
   "segment": "003.webp",
   "seg_y": 1019
  },
  {
   "i": 8,
   "who": "taeo",
   "type": "speech",
   "text": "GRANDPA, YOU DON'T HAVE TO COLLECT CARDBOARD ANYMORE.",
   "panel_id": "P07",
   "y_top": 7277,
   "y_bottom": 7699,
   "segment": "003.webp",
   "seg_y": 1547
  },
  {
   "i": 9,
   "who": "offpanel:grandpa",
   "type": "speech",
   "text": "IT'S FINE. THE SCRAP YARD WAS ON THE WAY.",
   "panel_id": "P07",
   "y_top": 7721,
   "y_bottom": 8077,
   "segment": "003.webp",
   "seg_y": 1925
  },
  {
   "i": 10,
   "who": "nib",
   "type": "speech",
   "text": "WHY ARE THE BOATS ASLEEP?",
   "panel_id": "P08",
   "y_top": 8483,
   "y_bottom": 8705,
   "segment": "004.webp",
   "seg_y": 281
  },
  {
   "i": 11,
   "who": "grandpa",
   "type": "speech",
   "text": "THE FISH ARE INSIDE THE GATE BUOYS.",
   "panel_id": "P08",
   "y_top": 8576,
   "y_bottom": 8798,
   "segment": "004.webp",
   "seg_y": 374
  },
  {
   "i": 12,
   "who": "grandpa",
   "type": "speech",
   "text": "AND NOBODY'S ALLOWED INSIDE THOSE BUOYS.",
   "panel_id": "P08",
   "y_top": 9307,
   "y_bottom": 9528,
   "segment": "004.webp",
   "seg_y": 1104
  },
  {
   "i": 13,
   "who": "scrap_dealer",
   "type": "speech",
   "text": "SIXTY-FOUR KILOS.",
   "panel_id": "P09",
   "y_top": 9660,
   "y_bottom": 9814,
   "segment": "004.webp",
   "seg_y": 1390
  },
  {
   "i": 14,
   "who": "scrap_dealer",
   "type": "speech",
   "text": "FIFTY WON A KILO. THREE THOUSAND TWO HUNDRED WON FOR THE LOT.",
   "panel_id": "P09",
   "y_top": 9832,
   "y_bottom": 10054,
   "segment": "004.webp",
   "seg_y": 1630
  },
  {
   "i": 15,
   "who": "nib",
   "type": "speech",
   "text": "I EARNED TWENTY THOUSAND WON FOR AN HOUR OF SCOUTING.",
   "panel_id": "P11",
   "y_top": 11180,
   "y_bottom": 11603,
   "segment": "005.webp",
   "seg_y": 877
  },
  {
   "i": 16,
   "who": "grandpa",
   "type": "speech",
   "text": "THEN DON'T TAKE UP CARDBOARD.",
   "panel_id": "P11",
   "y_top": 11625,
   "y_bottom": 11847,
   "segment": "005.webp",
   "seg_y": 1121
  },
  {
   "i": 17,
   "who": "taeo",
   "type": "float",
   "text": "I SEND MONEY EVERY MONTH. HE STILL PULLS THE CART.",
   "panel_id": "P11",
   "y_top": 11869,
   "y_bottom": 11994,
   "segment": "005.webp",
   "seg_y": 1268
  },
  {
   "i": 18,
   "who": "haru",
   "type": "shout",
   "text": "HYUNG!!",
   "panel_id": "P12",
   "y_top": 12400,
   "y_bottom": 12550,
   "segment": "005.webp",
   "seg_y": 1824
  },
  {
   "i": 19,
   "who": "grandma",
   "type": "shout",
   "text": "NOON, I SAID!",
   "panel_id": "P12",
   "y_top": 12568,
   "y_bottom": 12792,
   "segment": "005.webp",
   "seg_y": 2066
  },
  {
   "i": 20,
   "who": "taeo",
   "type": "speech",
   "text": "SORRY!",
   "panel_id": "P12",
   "y_top": 13401,
   "y_bottom": 13488,
   "segment": "005.webp",
   "seg_y": 2762
  },
  {
   "i": 21,
   "who": "haru",
   "type": "speech",
   "text": "YOU'RE SHORTER THAN ME.",
   "panel_id": "P13",
   "y_top": 13620,
   "y_bottom": 13841,
   "segment": "006.webp",
   "seg_y": 283
  },
  {
   "i": 22,
   "who": "nib",
   "type": "speech",
   "text": "YOU'RE YOUNGER THAN ME.",
   "panel_id": "P14",
   "y_top": 14539,
   "y_bottom": 14761,
   "segment": "007.webp",
   "seg_y": 332
  },
  {
   "i": 23,
   "who": "haru",
   "type": "speech",
   "text": "ARE GOBLINS OLDER THAN DINOSAURS? HAVE YOU SEEN A DINOSAUR? HOW FAST CAN YOU RUN?",
   "panel_id": "P14",
   "y_top": 14779,
   "y_bottom": 15067,
   "segment": "007.webp",
   "seg_y": 638
  },
  {
   "i": 24,
   "who": "haru",
   "type": "speech",
   "text": "WHO WOULD WIN, A GOBLIN OR A T. REX?",
   "panel_id": "P14",
   "y_top": 15571,
   "y_bottom": 15793,
   "segment": "007.webp",
   "seg_y": 1364
  },
  {
   "i": 25,
   "who": "nib",
   "type": "speech",
   "text": "WHOEVER SEES THE ENEMY FIRST WINS.",
   "panel_id": "P15",
   "y_top": 15899,
   "y_bottom": 16254,
   "segment": "007.webp",
   "seg_y": 1825
  },
  {
   "i": 26,
   "who": "offpanel:haru",
   "type": "speech",
   "text": "THAT'S NOT AN ANSWER.",
   "panel_id": "P15",
   "y_top": 16276,
   "y_bottom": 16497,
   "segment": "007.webp",
   "seg_y": 2068
  },
  {
   "i": 27,
   "who": "nib",
   "type": "speech",
   "text": "IT'S THE ONLY ANSWER.",
   "panel_id": "P15",
   "y_top": 16519,
   "y_bottom": 16741,
   "segment": "007.webp",
   "seg_y": 2312
  },
  {
   "i": 28,
   "who": "haru",
   "type": "speech",
   "text": "YOU ACTUALLY CAME.",
   "panel_id": "P16",
   "y_top": 16825,
   "y_bottom": 17047,
   "segment": "007.webp",
   "seg_y": 2618
  },
  {
   "i": 29,
   "who": "offpanel:taeo",
   "type": "speech",
   "text": "I SAID I WOULD, BOSS.",
   "panel_id": "P16",
   "y_top": 17069,
   "y_bottom": 17290,
   "segment": "007.webp",
   "seg_y": 2861
  },
  {
   "i": 30,
   "who": "haru",
   "type": "speech",
   "text": "YOU SAID THAT LAST TIME.",
   "panel_id": "P16",
   "y_top": 17312,
   "y_bottom": 17534,
   "segment": "007.webp",
   "seg_y": 3105
  },
  {
   "i": 31,
   "who": "haru",
   "type": "speech",
   "text": "THE SPICY SEAWEED SNACKS?",
   "panel_id": "P17",
   "y_top": 17940,
   "y_bottom": 18161,
   "segment": "008.webp",
   "seg_y": 332
  },
  {
   "i": 32,
   "who": "taeo",
   "type": "speech",
   "text": "OBVIOUSLY.",
   "panel_id": "P17",
   "y_top": 18179,
   "y_bottom": 18266,
   "segment": "008.webp",
   "seg_y": 437
  },
  {
   "i": 33,
   "who": "haru",
   "type": "speech",
   "text": "FINE. YOU CAN STAY.",
   "panel_id": "P17",
   "y_top": 18847,
   "y_bottom": 19001,
   "segment": "008.webp",
   "seg_y": 1172
  },
  {
   "i": 34,
   "who": "grandma",
   "type": "speech",
   "text": "YOU ASKED TO VISIT US.",
   "panel_id": "P18",
   "y_top": 19133,
   "y_bottom": 19355,
   "segment": "008.webp",
   "seg_y": 1526
  },
  {
   "i": 35,
   "who": "nib",
   "type": "speech",
   "text": "YES.",
   "panel_id": "P18",
   "y_top": 19373,
   "y_bottom": 19459,
   "segment": "008.webp",
   "seg_y": 1630
  },
  {
   "i": 36,
   "who": "grandma",
   "type": "speech",
   "text": "GOOD. YOU'LL EAT.",
   "panel_id": "P18",
   "y_top": 20040,
   "y_bottom": 20194,
   "segment": "008.webp",
   "seg_y": 2365
  },
  {
   "i": 37,
   "who": "taeo",
   "type": "speech",
   "text": "SORRY, GRANDMA. YOU DIDN'T HAVE TO PAY OUR BUS FARES.",
   "panel_id": "P19",
   "y_top": 20481,
   "y_bottom": 20703,
   "segment": "008.webp",
   "seg_y": 2874
  },
  {
   "i": 38,
   "who": "offpanel:grandma",
   "type": "speech",
   "text": "YOU'D HAVE WALKED.",
   "panel_id": "P19",
   "y_top": 20725,
   "y_bottom": 20879,
   "segment": "008.webp",
   "seg_y": 3050
  },
  {
   "i": 39,
   "who": "haru",
   "type": "speech",
   "text": "THE MACKEREL'S FROM NORWAY! THE PACKET SAID SO.",
   "panel_id": "P20",
   "y_top": 21466,
   "y_bottom": 21688,
   "segment": "009.webp",
   "seg_y": 628
  },
  {
   "i": 40,
   "who": "grandma",
   "type": "speech",
   "text": "FORTY YEARS I SOLD FISH FROM OUR OWN HARBOUR.",
   "panel_id": "P20",
   "y_top": 21706,
   "y_bottom": 21927,
   "segment": "009.webp",
   "seg_y": 867
  },
  {
   "i": 41,
   "who": "grandma",
   "type": "speech",
   "text": "NIB CAN BONE A MACKEREL.",
   "panel_id": "P21",
   "y_top": 22678,
   "y_bottom": 22900,
   "segment": "010.webp",
   "seg_y": 332
  },
  {
   "i": 42,
   "who": "haru",
   "type": "speech",
   "text": "WITH HIS HANDS!",
   "panel_id": "P21",
   "y_top": 22918,
   "y_bottom": 23072,
   "segment": "010.webp",
   "seg_y": 504
  },
  {
   "i": 43,
   "who": "haru",
   "type": "speech",
   "text": "NIB'S HOLDING THE CHOPSTICKS LIKE KNIVES!",
   "panel_id": "P23",
   "y_top": 25405,
   "y_bottom": 25828,
   "segment": "011.webp",
   "seg_y": 507
  },
  {
   "i": 44,
   "who": "nib",
   "type": "speech",
   "text": "THEY'RE BAD KNIVES.",
   "panel_id": "P23",
   "y_top": 25850,
   "y_bottom": 26071,
   "segment": "011.webp",
   "seg_y": 750
  },
  {
   "i": 45,
   "who": "grandma",
   "type": "speech",
   "text": "PUT THE CHOPSTICKS DOWN. HANDS ARE OLDER THAN CHOPSTICKS.",
   "panel_id": "P24",
   "y_top": 26181,
   "y_bottom": 26403,
   "segment": "011.webp",
   "seg_y": 1082
  },
  {
   "i": 46,
   "who": "nib",
   "type": "speech",
   "text": "THANK YOU.",
   "panel_id": "P24",
   "y_top": 26421,
   "y_bottom": 26511,
   "segment": "011.webp",
   "seg_y": 1190
  },
  {
   "i": 47,
   "who": "offpanel:grandma",
   "type": "speech",
   "text": "GRANDPA! HARU! USE YOUR CHOPSTICKS.",
   "panel_id": "P25",
   "y_top": 27256,
   "y_bottom": 27419,
   "segment": "011.webp",
   "seg_y": 2098
  },
  {
   "i": 48,
   "who": "grandma",
   "type": "speech",
   "text": "NOW. TELL US WHAT HAPPENED.",
   "panel_id": "P26",
   "y_top": 28100,
   "y_bottom": 28322,
   "segment": "012.webp",
   "seg_y": 628
  },
  {
   "i": 49,
   "who": "grandma",
   "type": "speech",
   "text": "FROM THE BEGINNING.",
   "panel_id": "P26",
   "y_top": 28340,
   "y_bottom": 28494,
   "segment": "012.webp",
   "seg_y": 800
  },
  {
   "i": 50,
   "who": "taeo",
   "type": "speech",
   "text": "A GATE OPENED IN THE SHOP ON TUESDAY. EVERYONE GOT OUT.",
   "panel_id": "P27",
   "y_top": 29216,
   "y_bottom": 29438,
   "segment": "013.webp",
   "seg_y": 332
  },
  {
   "i": 51,
   "who": "taeo",
   "type": "speech",
   "text": "I AWAKENED AS A SUMMONER, BUT MY OUTPUT IS LOW.",
   "panel_id": "P27",
   "y_top": 29456,
   "y_bottom": 29677,
   "segment": "013.webp",
   "seg_y": 571
  },
  {
   "i": 52,
   "who": "haru",
   "type": "speech",
   "text": "GOOD. YOU CAN STAY HOME.",
   "panel_id": "P27",
   "y_top": 30239,
   "y_bottom": 30460,
   "segment": "013.webp",
   "seg_y": 1354
  },
  {
   "i": 53,
   "who": "grandma",
   "type": "speech",
   "text": "TUESDAY.",
   "panel_id": "P28",
   "y_top": 30579,
   "y_bottom": 30666,
   "segment": "013.webp",
   "seg_y": 1560
  },
  {
   "i": 54,
   "who": "grandma",
   "type": "speech",
   "text": "ON TUESDAY YOU WROTE 'TELL HER I ATE.'",
   "panel_id": "P28",
   "y_top": 30688,
   "y_bottom": 30977,
   "segment": "013.webp",
   "seg_y": 1871
  },
  {
   "i": 55,
   "who": "offpanel:taeo",
   "type": "speech",
   "text": "I HAD EATEN.",
   "panel_id": "P28",
   "y_top": 30999,
   "y_bottom": 31153,
   "segment": "013.webp",
   "seg_y": 2047
  },
  {
   "i": 56,
   "who": "grandma",
   "type": "intense",
   "text": "YOON. TAEO.",
   "panel_id": "P29",
   "y_top": 31276,
   "y_bottom": 31486,
   "segment": "013.webp",
   "seg_y": 2380
  },
  {
   "i": 57,
   "who": "taeo",
   "type": "speech",
   "text": "I WAS SCARED, SO I DIDN'T CALL.",
   "panel_id": "P30",
   "y_top": 32827,
   "y_bottom": 32981,
   "segment": "014.webp",
   "seg_y": 819
  },
  {
   "i": 58,
   "who": "grandma",
   "type": "speech",
   "text": "ARE YOU HURT?",
   "panel_id": "P32",
   "y_top": 33917,
   "y_bottom": 34071,
   "segment": "014.webp",
   "seg_y": 1909
  },
  {
   "i": 59,
   "who": "taeo",
   "type": "speech",
   "text": "NO. IT'S FINE.",
   "panel_id": "P32",
   "y_top": 33981,
   "y_bottom": 34135,
   "segment": "014.webp",
   "seg_y": 1973
  },
  {
   "i": 60,
   "who": "grandma",
   "type": "speech",
   "text": "DON'T YOU START.",
   "panel_id": "P32",
   "y_top": 34692,
   "y_bottom": 34846,
   "segment": "014.webp",
   "seg_y": 2684
  },
  {
   "i": 61,
   "who": "taeo",
   "type": "speech",
   "text": "KANGHAN INSTITUTE WANTS TO STUDY NIB FOR FIVE YEARS.",
   "panel_id": "P35",
   "y_top": 35395,
   "y_bottom": 35617,
   "segment": "015.webp",
   "seg_y": 332
  },
  {
   "i": 62,
   "who": "taeo",
   "type": "speech",
   "text": "THEY OFFERED ME FIFTY MILLION WON.",
   "panel_id": "P35",
   "y_top": 35635,
   "y_bottom": 35856,
   "segment": "015.webp",
   "seg_y": 571
  },
  {
   "i": 63,
   "who": "grandma",
   "type": "shout",
   "text": "FIFTY MILLION?!",
   "panel_id": "P36",
   "y_top": 36554,
   "y_bottom": 36779,
   "segment": "015.webp",
   "seg_y": 1494
  },
  {
   "i": 64,
   "who": "haru",
   "type": "shout",
   "text": "HOW MANY SNACKS COULD FIFTY MILLION BUY?!",
   "panel_id": "P36",
   "y_top": 36797,
   "y_bottom": 37140,
   "segment": "015.webp",
   "seg_y": 1855
  },
  {
   "i": 65,
   "who": "grandma",
   "type": "speech",
   "text": "DID YOU SAY NO?",
   "panel_id": "P37",
   "y_top": 37886,
   "y_bottom": 38040,
   "segment": "016.webp",
   "seg_y": 264
  },
  {
   "i": 66,
   "who": "nib",
   "type": "speech",
   "text": "EVENTUALLY.",
   "panel_id": "P37",
   "y_top": 38058,
   "y_bottom": 38145,
   "segment": "016.webp",
   "seg_y": 369
  },
  {
   "i": 67,
   "who": "taeo",
   "type": "nervous",
   "text": "I SAID NIB'S NOT MINE TO SELL.",
   "panel_id": "P37",
   "y_top": 38704,
   "y_bottom": 38920,
   "segment": "016.webp",
   "seg_y": 1144
  },
  {
   "i": 68,
   "who": "taeo",
   "type": "speech",
   "text": "IN TWENTY DAYS, A PANEL DECIDES IF NIB IS A PERSON OR A CONSTRUCT.",
   "panel_id": "P38",
   "y_top": 39052,
   "y_bottom": 39273,
   "segment": "016.webp",
   "seg_y": 1497
  },
  {
   "i": 69,
   "who": "taeo",
   "type": "speech",
   "text": "IF THEY CALL NIB A CONSTRUCT, HE CAN BE SOLD AS PROPERTY.",
   "panel_id": "P38",
   "y_top": 39291,
   "y_bottom": 39513,
   "segment": "016.webp",
   "seg_y": 1737
  },
  {
   "i": 70,
   "who": "haru",
   "type": "speech",
   "text": "A T. REX CALLED SUE GOT SOLD FOR EIGHT MILLION DOLLARS.",
   "panel_id": "P39",
   "y_top": 40211,
   "y_bottom": 40433,
   "segment": "017.webp",
   "seg_y": 332
  },
  {
   "i": 71,
   "who": "nib",
   "type": "speech",
   "text": "WAS SHE ALIVE?",
   "panel_id": "P39",
   "y_top": 40304,
   "y_bottom": 40458,
   "segment": "017.webp",
   "seg_y": 357
  },
  {
   "i": 72,
   "who": "haru",
   "type": "speech",
   "text": "NO.",
   "panel_id": "P39",
   "y_top": 41039,
   "y_bottom": 41126,
   "segment": "017.webp",
   "seg_y": 1025
  },
  {
   "i": 73,
   "who": "nib",
   "type": "speech",
   "text": "THEN SUE DIDN'T GET A SAY.",
   "panel_id": "P40",
   "y_top": 41421,
   "y_bottom": 41643,
   "segment": "017.webp",
   "seg_y": 1542
  },
  {
   "i": 74,
   "who": "grandma",
   "type": "speech",
   "text": "NIB BONED A MACKEREL AT MY TABLE. HE'S A PERSON.",
   "panel_id": "P41",
   "y_top": 41942,
   "y_bottom": 42164,
   "segment": "018.webp",
   "seg_y": 332
  },
  {
   "i": 75,
   "who": "grandma",
   "type": "speech",
   "text": "TELL THE REVIEW PANEL I SAID SO.",
   "panel_id": "P41",
   "y_top": 42182,
   "y_bottom": 42336,
   "segment": "018.webp",
   "seg_y": 504
  },
  {
   "i": 76,
   "who": "grandpa",
   "type": "speech",
   "text": "IT'S FINE. IT'LL BE FINE.",
   "panel_id": "P41",
   "y_top": 42869,
   "y_bottom": 43090,
   "segment": "018.webp",
   "seg_y": 1258
  },
  {
   "i": 77,
   "who": "grandma",
   "type": "speech",
   "text": "GRANDPA DOESN'T TAKE ANYONE TO THE BREAKWATER. HE CALLS IT THE WALL.",
   "panel_id": "P42",
   "y_top": 43518,
   "y_bottom": 43807,
   "segment": "018.webp",
   "seg_y": 1975
  },
  {
   "i": 78,
   "who": "taeo",
   "type": "speech",
   "text": "WHY DOES HE GO ALONE?",
   "panel_id": "P42",
   "y_top": 43639,
   "y_bottom": 43861,
   "segment": "018.webp",
   "seg_y": 2029
  },
  {
   "i": 79,
   "who": "grandma",
   "type": "speech",
   "text": "ASK HIM. HE'LL SAY IT'S FINE.",
   "panel_id": "P42",
   "y_top": 44370,
   "y_bottom": 44591,
   "segment": "018.webp",
   "seg_y": 2759
  },
  {
   "i": 80,
   "who": "nib",
   "type": "speech",
   "text": "GOOD WALL.",
   "panel_id": "P43",
   "y_top": 45019,
   "y_bottom": 45113,
   "segment": "019.webp",
   "seg_y": 153
  },
  {
   "i": 81,
   "who": "nib",
   "type": "speech",
   "text": "YOU DRANK FIRST.",
   "panel_id": "P45",
   "y_top": 46703,
   "y_bottom": 46856,
   "segment": "019.webp",
   "seg_y": 1896
  },
  {
   "i": 82,
   "who": "offpanel:grandpa",
   "type": "speech",
   "text": "WE ALWAYS DRANK FIRST ON WATCH.",
   "panel_id": "P45",
   "y_top": 46878,
   "y_bottom": 47168,
   "segment": "019.webp",
   "seg_y": 2208
  },
  {
   "i": 83,
   "who": "nib",
   "type": "speech",
   "text": "YOU WATCH THE SEA GATE.",
   "panel_id": "P46",
   "y_top": 47345,
   "y_bottom": 47499,
   "segment": "019.webp",
   "seg_y": 2539
  },
  {
   "i": 84,
   "who": "grandpa",
   "type": "speech",
   "text": "SOMEBODY SHOULD.",
   "panel_id": "P46",
   "y_top": 47409,
   "y_bottom": 47563,
   "segment": "019.webp",
   "seg_y": 2603
  },
  {
   "i": 85,
   "who": "grandpa",
   "type": "speech",
   "text": "I WAS A CONSCRIPT ON A COAST LIKE THIS. THREE YEARS OF NIGHT WATCHES.",
   "panel_id": "P47",
   "y_top": 48285,
   "y_bottom": 48507,
   "segment": "020.webp",
   "seg_y": 332
  },
  {
   "i": 86,
   "who": "nib",
   "type": "speech",
   "text": "ALONE?",
   "panel_id": "P47",
   "y_top": 48378,
   "y_bottom": 48465,
   "segment": "020.webp",
   "seg_y": 290
  },
  {
   "i": 87,
   "who": "grandpa",
   "type": "speech",
   "text": "TWO HOURS AT A TIME. THEN YOUR RELIEF CAME TO TAKE THE NEXT WATCH.",
   "panel_id": "P47",
   "y_top": 49016,
   "y_bottom": 49238,
   "segment": "020.webp",
   "seg_y": 1063
  },
  {
   "i": 88,
   "who": "offpanel:grandpa",
   "type": "speech",
   "text": "THE LAST HOUR OF WATCH WAS WORSE THAN THE COLD.",
   "panel_id": "P48",
   "y_top": 49806,
   "y_bottom": 50027,
   "segment": "020.webp",
   "seg_y": 1852
  },
  {
   "i": 89,
   "who": "offpanel:grandpa",
   "type": "speech",
   "text": "SOMEBODY ALWAYS COMES TO TAKE OVER.",
   "panel_id": "P48",
   "y_top": 50045,
   "y_bottom": 50266,
   "segment": "020.webp",
   "seg_y": 2091
  },
  {
   "i": 90,
   "who": "nib",
   "type": "speech",
   "text": "MY RELIEF WILL FIND MY POST EMPTY.",
   "panel_id": "P49",
   "y_top": 51017,
   "y_bottom": 51239,
   "segment": "020.webp",
   "seg_y": 3064
  },
  {
   "i": 91,
   "who": "grandpa",
   "type": "speech",
   "text": "WHO'S YOUR RELIEF?",
   "panel_id": "P50",
   "y_top": 51678,
   "y_bottom": 51832,
   "segment": "021.webp",
   "seg_y": 339
  },
  {
   "i": 92,
   "who": "nib",
   "type": "speech",
   "text": "KETT. I TRAINED HIM.",
   "panel_id": "P50",
   "y_top": 51854,
   "y_bottom": 52075,
   "segment": "021.webp",
   "seg_y": 582
  },
  {
   "i": 93,
   "who": "grandpa",
   "type": "speech",
   "text": "THEN HE'LL KNOW YOU DIDN'T RUN.",
   "panel_id": "P51",
   "y_top": 52287,
   "y_bottom": 52441,
   "segment": "021.webp",
   "seg_y": 948
  },
  {
   "i": 94,
   "who": "taeo",
   "type": "float",
   "text": "I ALWAYS TAKE THE LAST BUS.",
   "panel_id": "P53",
   "y_top": 54196,
   "y_bottom": 54283,
   "segment": "022.webp",
   "seg_y": 493
  },
  {
   "i": 95,
   "who": "taeo",
   "type": "float",
   "text": "IT STILL COMES TOO EARLY.",
   "panel_id": "P53",
   "y_top": 54301,
   "y_bottom": 54388,
   "segment": "022.webp",
   "seg_y": 598
  },
  {
   "i": 96,
   "who": "haru",
   "type": "speech",
   "text": "I BROUGHT YOU A DINOSAUR STICKER. IT MATCHES THE ONE ON HYUNG'S PHONE.",
   "panel_id": "P54",
   "y_top": 55234,
   "y_bottom": 55523,
   "segment": "022.webp",
   "seg_y": 1733
  },
  {
   "i": 97,
   "who": "nib",
   "type": "speech",
   "text": "THE SHOUTING BRICK HAS A DINOSAUR.",
   "panel_id": "P54",
   "y_top": 55541,
   "y_bottom": 55762,
   "segment": "022.webp",
   "seg_y": 1972
  },
  {
   "i": 98,
   "who": "haru",
   "type": "speech",
   "text": "THE SHOUTING BRICK!",
   "panel_id": "P54",
   "y_top": 56271,
   "y_bottom": 56493,
   "segment": "022.webp",
   "seg_y": 2703
  },
  {
   "i": 99,
   "who": "nib",
   "type": "speech",
   "text": "I'LL KEEP IT DRY.",
   "panel_id": "P55",
   "y_top": 56902,
   "y_bottom": 57056,
   "segment": "023.webp",
   "seg_y": 457
  },
  {
   "i": 100,
   "who": "grandma",
   "type": "speech",
   "text": "SIDE DISHES FOR YOU AND NIB. EAT THEM.",
   "panel_id": "P57",
   "y_top": 58153,
   "y_bottom": 58374,
   "segment": "023.webp",
   "seg_y": 1775
  },
  {
   "i": 101,
   "who": "grandma",
   "type": "speech",
   "text": "AND CALL ME. TYPING 'I ATE' DOESN'T COUNT.",
   "panel_id": "P57",
   "y_top": 58392,
   "y_bottom": 58613,
   "segment": "023.webp",
   "seg_y": 2014
  },
  {
   "i": 102,
   "who": "taeo",
   "type": "speech",
   "text": "I'LL CALL.",
   "panel_id": "P57",
   "y_top": 59170,
   "y_bottom": 59257,
   "segment": "023.webp",
   "seg_y": 2658
  },
  {
   "i": 103,
   "who": "taeo",
   "type": "speech",
   "text": "GRANDPA, YOU EARNED THIS MONEY FROM YOUR CARDBOARD.",
   "panel_id": "P58",
   "y_top": 59389,
   "y_bottom": 59611,
   "segment": "023.webp",
   "seg_y": 3012
  },
  {
   "i": 104,
   "who": "offpanel:grandpa",
   "type": "speech",
   "text": "IT'S FINE.",
   "panel_id": "P58",
   "y_top": 59482,
   "y_bottom": 59568,
   "segment": "023.webp",
   "seg_y": 2969
  },
  {
   "i": 105,
   "who": "grandpa",
   "type": "speech",
   "text": "YOUR FATHER WENT IN FIRST TOO, YOU KNOW.",
   "panel_id": "P59",
   "y_top": 59975,
   "y_bottom": 60196,
   "segment": "024.webp",
   "seg_y": 331
  },
  {
   "i": 106,
   "who": "grandpa",
   "type": "whisper",
   "text": "...DON'T YOU EVER.",
   "panel_id": "P61",
   "y_top": 62746,
   "y_bottom": 62878,
   "segment": "025.webp",
   "seg_y": 1705
  }

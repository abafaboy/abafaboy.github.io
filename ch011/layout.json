 "lines": [
  {
   "i": 1,
   "who": "taeo",
   "type": "float",
   "text": "THE FIRST QUIET IN WEEKS.",
   "panel_id": "P01",
   "y_top": 26,
   "y_bottom": 113,
   "segment": "001.webp",
   "seg_y": 113
  },
  {
   "i": 2,
   "who": "haein",
   "type": "speech",
   "text": "STILL NO RADIO SIGNAL.",
   "panel_id": "P04",
   "y_top": 4392,
   "y_bottom": 4614,
   "segment": "002.webp",
   "seg_y": 2068
  },
  {
   "i": 3,
   "who": "haein",
   "type": "speech",
   "text": "LOW BAND, HIGH BAND. NO RADIO SIGNAL GETS THROUGH.",
   "panel_id": "P05",
   "y_top": 5339,
   "y_bottom": 5761,
   "segment": "003.webp",
   "seg_y": 506
  },
  {
   "i": 4,
   "who": "haein",
   "type": "speech",
   "text": "I KEEP TRYING ANYWAY.",
   "panel_id": "P05",
   "y_top": 5783,
   "y_bottom": 6005,
   "segment": "003.webp",
   "seg_y": 750
  },
  {
   "i": 5,
   "who": "haein",
   "type": "speech",
   "text": "STAY BEHIND THE TAPE.",
   "panel_id": "P06",
   "y_top": 6115,
   "y_bottom": 6337,
   "segment": "003.webp",
   "seg_y": 1082
  },
  {
   "i": 6,
   "who": "taeo",
   "type": "nervous",
   "text": "S-SORRY.",
   "panel_id": "P06",
   "y_top": 6208,
   "y_bottom": 6297,
   "segment": "003.webp",
   "seg_y": 1042
  },
  {
   "i": 7,
   "who": "sejin",
   "type": "speech",
   "text": "KNOCK AFTER FORTY MINUTES INSIDE. IT'S BEEN SIX.",
   "panel_id": "P07",
   "y_top": 7043,
   "y_bottom": 7466,
   "segment": "003.webp",
   "seg_y": 2211
  },
  {
   "i": 8,
   "who": "offpanel:taeo",
   "type": "speech",
   "text": "I KNOW.",
   "panel_id": "P07",
   "y_top": 7488,
   "y_bottom": 7574,
   "segment": "003.webp",
   "seg_y": 2319
  },
  {
   "i": 9,
   "who": "taeo",
   "type": "float",
   "text": "I SAID WAITING WAS THE HARD PART.",
   "panel_id": "P08",
   "y_top": 7719,
   "y_bottom": 7806,
   "segment": "003.webp",
   "seg_y": 2551
  },
  {
   "i": 10,
   "who": "taeo",
   "type": "float",
   "text": "I HADN'T WAITED YET.",
   "panel_id": "P08",
   "y_top": 7824,
   "y_bottom": 7911,
   "segment": "003.webp",
   "seg_y": 2656
  },
  {
   "i": 11,
   "who": "crew",
   "type": "speech",
   "text": "YOU'RE THE SPOTTER. LET THE MULE TAKE IT.",
   "panel_id": "P09",
   "y_top": 9053,
   "y_bottom": 9275,
   "segment": "004.webp",
   "seg_y": 628
  },
  {
   "i": 12,
   "who": "nib",
   "type": "speech",
   "text": "I CAN CARRY.",
   "panel_id": "P09",
   "y_top": 9145,
   "y_bottom": 9300,
   "segment": "004.webp",
   "seg_y": 653
  },
  {
   "i": 13,
   "who": "nib",
   "type": "speech",
   "text": "YOU CARRY. I LOOK.",
   "panel_id": "P11",
   "y_top": 10759,
   "y_bottom": 10912,
   "segment": "004.webp",
   "seg_y": 2265
  },
  {
   "i": 14,
   "who": "minho",
   "type": "speech",
   "text": "GOOD. NOW LOOK.",
   "panel_id": "P11",
   "y_top": 10930,
   "y_bottom": 11084,
   "segment": "004.webp",
   "seg_y": 2437
  },
  {
   "i": 15,
   "who": "nib",
   "type": "phone",
   "text": "GRIT ON THE LEFT. KEEP RIGHT.",
   "panel_id": "P12",
   "y_top": 12372,
   "y_bottom": 12582,
   "segment": "005.webp",
   "seg_y": 802
  },
  {
   "i": 16,
   "who": "minho",
   "type": "speech",
   "text": "SEEN.",
   "panel_id": "P12",
   "y_top": 12600,
   "y_bottom": 12687,
   "segment": "005.webp",
   "seg_y": 907
  },
  {
   "i": 17,
   "who": "sejin",
   "type": "speech",
   "text": "TRAIN.",
   "panel_id": "P13",
   "y_top": 13115,
   "y_bottom": 13201,
   "segment": "005.webp",
   "seg_y": 1421
  },
  {
   "i": 18,
   "who": "haein",
   "type": "speech",
   "text": "THAT'S THE FOURTH ONE.",
   "panel_id": "P13",
   "y_top": 13219,
   "y_bottom": 13373,
   "segment": "005.webp",
   "seg_y": 1593
  },
  {
   "i": 19,
   "who": "taeo",
   "type": "speech",
   "text": "SORRY.",
   "panel_id": "P14",
   "y_top": 14116,
   "y_bottom": 14202,
   "segment": "006.webp",
   "seg_y": 217
  },
  {
   "i": 20,
   "who": "sejin",
   "type": "speech",
   "text": "I'M PAID TO WAIT. YOU'RE NOT. SIT DOWN.",
   "panel_id": "P14",
   "y_top": 14224,
   "y_bottom": 14514,
   "segment": "006.webp",
   "seg_y": 529
  },
  {
   "i": 21,
   "who": "taeo",
   "type": "speech",
   "text": "I'M FINE.",
   "panel_id": "P14",
   "y_top": 14536,
   "y_bottom": 14622,
   "segment": "006.webp",
   "seg_y": 637
  },
  {
   "i": 22,
   "who": "haein",
   "type": "speech",
   "text": "WHY DON'T YOU JUST GO IN WITH HIM?",
   "panel_id": "P15",
   "y_top": 14779,
   "y_bottom": 15000,
   "segment": "006.webp",
   "seg_y": 1015
  },
  {
   "i": 23,
   "who": "taeo",
   "type": "speech",
   "text": "I CAN'T GO IN.",
   "panel_id": "P15",
   "y_top": 14871,
   "y_bottom": 15025,
   "segment": "006.webp",
   "seg_y": 1040
  },
  {
   "i": 24,
   "who": "haein",
   "type": "speech",
   "text": "DAD USED TO GO IN FIRST. EVERY JOB.",
   "panel_id": "P16",
   "y_top": 15755,
   "y_bottom": 16044,
   "segment": "006.webp",
   "seg_y": 2059
  },
  {
   "i": 25,
   "who": "haein",
   "type": "speech",
   "text": "NOW MINHO DOES.",
   "panel_id": "P16",
   "y_top": 16066,
   "y_bottom": 16288,
   "segment": "006.webp",
   "seg_y": 2303
  },
  {
   "i": 26,
   "who": "haein",
   "type": "speech",
   "text": "I BUILD THINGS SO I CAN HELP FROM OUT HERE.",
   "panel_id": "P18",
   "y_top": 16944,
   "y_bottom": 17300,
   "segment": "007.webp",
   "seg_y": 478
  },
  {
   "i": 27,
   "who": "crew",
   "type": "speech",
   "text": "MULE. STOP.",
   "panel_id": "P19",
   "y_top": 17828,
   "y_bottom": 17918,
   "segment": "007.webp",
   "seg_y": 1096
  },
  {
   "i": 28,
   "who": "nib",
   "type": "speech",
   "text": "THE LAST STRUT. THERE'S A CRACK FROM TOP TO MIDDLE.",
   "panel_id": "P21",
   "y_top": 19133,
   "y_bottom": 19355,
   "segment": "008.webp",
   "seg_y": 332
  },
  {
   "i": 29,
   "who": "minho",
   "type": "speech",
   "text": "I DON'T SEE A CRACK.",
   "panel_id": "P21",
   "y_top": 19373,
   "y_bottom": 19527,
   "segment": "008.webp",
   "seg_y": 504
  },
  {
   "i": 30,
   "who": "nib",
   "type": "speech",
   "text": "THE GRIT'S MOVING.",
   "panel_id": "P21",
   "y_top": 20084,
   "y_bottom": 20237,
   "segment": "008.webp",
   "seg_y": 1214
  },
  {
   "i": 31,
   "who": "minho",
   "type": "speech",
   "text": "SEEN.",
   "panel_id": "P22",
   "y_top": 20600,
   "y_bottom": 20687,
   "segment": "008.webp",
   "seg_y": 1664
  },
  {
   "i": 32,
   "who": "minho",
   "type": "speech",
   "text": "THE WHITE OUTCROP IS OUR LAST SURVEY STATION. BRACE THE STRUT. ONE PERSON AT A TIME.",
   "panel_id": "P23",
   "y_top": 21053,
   "y_bottom": 21411,
   "segment": "008.webp",
   "seg_y": 2388
  },
  {
   "i": 33,
   "who": "minho",
   "type": "speech",
   "text": "THE MULE STAYS HERE.",
   "panel_id": "P23",
   "y_top": 21429,
   "y_bottom": 21583,
   "segment": "008.webp",
   "seg_y": 2560
  },
  {
   "i": 34,
   "who": "nib",
   "type": "speech",
   "text": "I'LL GO FIRST.",
   "panel_id": "P23",
   "y_top": 22140,
   "y_bottom": 22294,
   "segment": "008.webp",
   "seg_y": 3271
  },
  {
   "i": 35,
   "who": "haein",
   "type": "speech",
   "text": "TEN SECONDS UNTIL FORTY MINUTES.",
   "panel_id": "P25",
   "y_top": 24686,
   "y_bottom": 24908,
   "segment": "009.webp",
   "seg_y": 2508
  },
  {
   "i": 36,
   "who": "taeo",
   "type": "speech",
   "text": "TRAIN?",
   "panel_id": "P31",
   "y_top": 28873,
   "y_bottom": 28959,
   "segment": "011.webp",
   "seg_y": 187
  },
  {
   "i": 37,
   "who": "sejin",
   "type": "speech",
   "text": "THAT SOUND CAME THROUGH THE GATE.",
   "panel_id": "P31",
   "y_top": 28981,
   "y_bottom": 29271,
   "segment": "011.webp",
   "seg_y": 499
  },
  {
   "i": 38,
   "who": "taeo",
   "type": "intense",
   "text": "COME ON, NIB.",
   "panel_id": "P32",
   "y_top": 29482,
   "y_bottom": 29691,
   "segment": "011.webp",
   "seg_y": 919
  },
  {
   "i": 39,
   "who": "taeo",
   "type": "nervous",
   "text": "THREE.",
   "panel_id": "P35",
   "y_top": 33106,
   "y_bottom": 33190,
   "segment": "012.webp",
   "seg_y": 1814
  },
  {
   "i": 40,
   "who": "nib",
   "type": "speech",
   "text": "IT'S THE SAME KIND.",
   "panel_id": "P38",
   "y_top": 36274,
   "y_bottom": 36428,
   "segment": "014.webp",
   "seg_y": 480
  },
  {
   "i": 41,
   "who": "taeo",
   "type": "speech",
   "text": "THE SAME KIND AS WHAT?",
   "panel_id": "P38",
   "y_top": 36338,
   "y_bottom": 36560,
   "segment": "014.webp",
   "seg_y": 612
  },
  {
   "i": 42,
   "who": "nib",
   "type": "speech",
   "text": "THE WHITE BIT. BY MY WALL.",
   "panel_id": "P38",
   "y_top": 37093,
   "y_bottom": 37247,
   "segment": "014.webp",
   "seg_y": 1299
  },
  {
   "i": 43,
   "who": "taeo",
   "type": "speech",
   "text": "SORRY. MY LEGS GAVE OUT.",
   "panel_id": "P39",
   "y_top": 37379,
   "y_bottom": 37601,
   "segment": "014.webp",
   "seg_y": 1653
  },
  {
   "i": 44,
   "who": "nib",
   "type": "speech",
   "text": "YOU LOOK WORSE THAN ME.",
   "panel_id": "P40",
   "y_top": 38515,
   "y_bottom": 38737,
   "segment": "014.webp",
   "seg_y": 2789
  },
  {
   "i": 45,
   "who": "taeo",
   "type": "speech",
   "text": "YOU DIDN'T ANSWER THE KNOCKS.",
   "panel_id": "P41",
   "y_top": 39036,
   "y_bottom": 39258,
   "segment": "015.webp",
   "seg_y": 332
  },
  {
   "i": 46,
   "who": "nib",
   "type": "speech",
   "text": "WE WERE TOO FAR TO HEAR. MINHO HADN'T CROSSED THE DAMAGED STRUT YET.",
   "panel_id": "P41",
   "y_top": 39276,
   "y_bottom": 39564,
   "segment": "015.webp",
   "seg_y": 638
  },
  {
   "i": 47,
   "who": "nib",
   "type": "speech",
   "text": "ONCE MINHO WAS SAFE, I RAN BACK.",
   "panel_id": "P41",
   "y_top": 40068,
   "y_bottom": 40290,
   "segment": "015.webp",
   "seg_y": 1364
  },
  {
   "i": 48,
   "who": "sejin",
   "type": "speech",
   "text": "SAY 'AH'.",
   "panel_id": "P42",
   "y_top": 40410,
   "y_bottom": 40496,
   "segment": "015.webp",
   "seg_y": 1570
  },
  {
   "i": 49,
   "who": "taeo",
   "type": "speech",
   "text": "I WASN'T EVEN IN THERE.",
   "panel_id": "P42",
   "y_top": 40518,
   "y_bottom": 40740,
   "segment": "015.webp",
   "seg_y": 1814
  },
  {
   "i": 50,
   "who": "sejin",
   "type": "speech",
   "text": "NO. YOU WERE OUT HERE.",
   "panel_id": "P42",
   "y_top": 40762,
   "y_bottom": 40983,
   "segment": "015.webp",
   "seg_y": 2057
  },
  {
   "i": 51,
   "who": "nib",
   "type": "speech",
   "text": "YOU FIRST.",
   "panel_id": "P43",
   "y_top": 41106,
   "y_bottom": 41193,
   "segment": "015.webp",
   "seg_y": 2267
  },
  {
   "i": 52,
   "who": "minho",
   "type": "speech",
   "text": "THE CRACKED STRUT FELL BEHIND ME. STEEL PROP AND ALL.",
   "panel_id": "P44",
   "y_top": 41939,
   "y_bottom": 42161,
   "segment": "016.webp",
   "seg_y": 332
  },
  {
   "i": 53,
   "who": "minho",
   "type": "speech",
   "text": "OUR SURVEY IS FINISHED. THE FALL BLOCKED THE BEND.",
   "panel_id": "P44",
   "y_top": 42179,
   "y_bottom": 42400,
   "segment": "016.webp",
   "seg_y": 571
  },
  {
   "i": 54,
   "who": "haein",
   "type": "speech",
   "text": "MINHO. YOU'RE GREY.",
   "panel_id": "P44",
   "y_top": 42962,
   "y_bottom": 43184,
   "segment": "016.webp",
   "seg_y": 1355
  },
  {
   "i": 55,
   "who": "minho",
   "type": "speech",
   "text": "YOU WALKED UNDER THAT CRACKED STRUT FIRST.",
   "panel_id": "P45",
   "y_top": 43316,
   "y_bottom": 43605,
   "segment": "016.webp",
   "seg_y": 1776
  },
  {
   "i": 56,
   "who": "minho",
   "type": "speech",
   "text": "THIS NEW WHITE HAIR IS YOURS.",
   "panel_id": "P45",
   "y_top": 43623,
   "y_bottom": 43777,
   "segment": "016.webp",
   "seg_y": 1948
  },
  {
   "i": 57,
   "who": "nib",
   "type": "speech",
   "text": "YOU'RE WELCOME.",
   "panel_id": "P45",
   "y_top": 44267,
   "y_bottom": 44421,
   "segment": "016.webp",
   "seg_y": 2592
  },
  {
   "i": 58,
   "who": "haein",
   "type": "speech",
   "text": "KNOCKS GET THROUGH THE GATE, BUT WE CAN'T HEAR THEM FAR AWAY.",
   "panel_id": "P45a",
   "y_top": 44553,
   "y_bottom": 44775,
   "segment": "017.webp",
   "seg_y": 282
  },
  {
   "i": 59,
   "who": "haein",
   "type": "speech",
   "text": "A CABLE COULD CARRY A RADIO SIGNAL.",
   "panel_id": "P45a",
   "y_top": 44793,
   "y_bottom": 45014,
   "segment": "017.webp",
   "seg_y": 521
  },
  {
   "i": 60,
   "who": "offpanel:minho",
   "type": "speech",
   "text": "PRICE THE CABLE FIRST.",
   "panel_id": "P45a",
   "y_top": 45456,
   "y_bottom": 45678,
   "segment": "017.webp",
   "seg_y": 1185
  },
  {
   "i": 61,
   "who": "minho",
   "type": "speech",
   "text": "YOU SPOTTED THE CRACK FIRST. I'LL CREDIT YOU IN THE SURVEY REPORT.",
   "panel_id": "P46",
   "y_top": 45810,
   "y_bottom": 46031,
   "segment": "017.webp",
   "seg_y": 1538
  },
  {
   "i": 62,
   "who": "nib",
   "type": "speech",
   "text": "JUST NIB.",
   "panel_id": "P46",
   "y_top": 46049,
   "y_bottom": 46136,
   "segment": "017.webp",
   "seg_y": 1643
  },
  {
   "i": 63,
   "who": "minho",
   "type": "speech",
   "text": "JUST NIB.",
   "panel_id": "P46",
   "y_top": 46741,
   "y_bottom": 46827,
   "segment": "017.webp",
   "seg_y": 2334
  },
  {
   "i": 64,
   "who": "nib",
   "type": "speech",
   "text": "₩60,000. FOR FORTY-THREE MINUTES.",
   "panel_id": "P47",
   "y_top": 47395,
   "y_bottom": 47617,
   "segment": "018.webp",
   "seg_y": 284
  },
  {
   "i": 65,
   "who": "taeo",
   "type": "speech",
   "text": "IT'S A DAY RATE.",
   "panel_id": "P47",
   "y_top": 47635,
   "y_bottom": 47790,
   "segment": "018.webp",
   "seg_y": 457
  },
  {
   "i": 66,
   "who": "nib",
   "type": "speech",
   "text": "I LIKE DAY RATES.",
   "panel_id": "P47",
   "y_top": 48400,
   "y_bottom": 48553,
   "segment": "018.webp",
   "seg_y": 1220
  },
  {
   "i": 67,
   "who": "taeo",
   "type": "speech",
   "text": "DOES THE WHITE STONE MEAN HOME'S CLOSE?",
   "panel_id": "P49",
   "y_top": 49140,
   "y_bottom": 49361,
   "segment": "018.webp",
   "seg_y": 2028
  },
  {
   "i": 68,
   "who": "offpanel:nib",
   "type": "speech",
   "text": "ONLY THAT THE STONE MATCHES.",
   "panel_id": "P49",
   "y_top": 49379,
   "y_bottom": 49533,
   "segment": "018.webp",
   "seg_y": 2200
  },
  {
   "i": 69,
   "who": "reporter",
   "type": "phone",
   "text": "A PORTER IN HIS SIXTIES IS MISSING AFTER A DOKGO CONTRACTING JOB IN GURO.",
   "panel_id": "P51",
   "y_top": 51448,
   "y_bottom": 51721,
   "segment": "019.webp",
   "seg_y": 1143
  },

 "lines": [
  {
   "i": 1,
   "who": "park_doyun",
   "type": "phone",
   "text": "A CONSTRUCT FEELS NOTHING. FEARS NOTHING.",
   "panel_id": "P01",
   "y_top": 26,
   "y_bottom": 236,
   "segment": "001.webp",
   "seg_y": 236
  },
  {
   "i": 2,
   "who": "park_doyun",
   "type": "phone",
   "text": "SEND ONE IN, AND NO ONE ELSE HAS TO GO.",
   "panel_id": "P01",
   "y_top": 254,
   "y_bottom": 463,
   "segment": "001.webp",
   "seg_y": 463
  },
  {
   "i": 3,
   "who": "taeo",
   "type": "float",
   "text": "IN THE TUNNEL, I COULDN'T FEEL NIB. NOT ONCE.",
   "panel_id": "P02",
   "y_top": 1218,
   "y_bottom": 1305,
   "segment": "001.webp",
   "seg_y": 1305
  },
  {
   "i": 4,
   "who": "nib",
   "type": "speech",
   "text": "TURN OFF THE SHOUTING BRICK.",
   "panel_id": "P03",
   "y_top": 2270,
   "y_bottom": 2424,
   "segment": "001.webp",
   "seg_y": 2424
  },
  {
   "i": 5,
   "who": "offpanel:taeo",
   "type": "whisper",
   "text": "SORRY. ONE MORE LECTURE.",
   "panel_id": "P03",
   "y_top": 2446,
   "y_bottom": 2635,
   "segment": "001.webp",
   "seg_y": 2635
  },
  {
   "i": 6,
   "who": "offpanel:park_doyun",
   "type": "phone",
   "text": "IF IT SEEMS TO WANT SOMETHING, ASK WHAT **YOU** WANT.",
   "panel_id": "P04",
   "y_top": 2942,
   "y_bottom": 3164,
   "segment": "002.webp",
   "seg_y": 332
  },
  {
   "i": 7,
   "who": "nib",
   "type": "speech",
   "text": "THE PORTER ON THE NEWS. DID THEY FIND HIM?",
   "panel_id": "P06",
   "y_top": 5911,
   "y_bottom": 6132,
   "segment": "003.webp",
   "seg_y": 627
  },
  {
   "i": 8,
   "who": "taeo",
   "type": "speech",
   "text": "NO UPDATE. THE COMPANY SAYS HE LEFT 'VOLUNTARILY'.",
   "panel_id": "P06",
   "y_top": 6150,
   "y_bottom": 6440,
   "segment": "003.webp",
   "seg_y": 935
  },
  {
   "i": 9,
   "who": "nib",
   "type": "speech",
   "text": "WHAT'S 'VOLUNTARILY'?",
   "panel_id": "P07",
   "y_top": 7160,
   "y_bottom": 7314,
   "segment": "003.webp",
   "seg_y": 1809
  },
  {
   "i": 10,
   "who": "taeo",
   "type": "speech",
   "text": "BY HIS OWN CHOICE.",
   "panel_id": "P07",
   "y_top": 7336,
   "y_bottom": 7490,
   "segment": "003.webp",
   "seg_y": 1985
  },
  {
   "i": 11,
   "who": "nib",
   "type": "speech",
   "text": "THEN SOMEBODY SAW THE PORTER LEAVE. WHO?",
   "panel_id": "P07",
   "y_top": 7512,
   "y_bottom": 7934,
   "segment": "003.webp",
   "seg_y": 2429
  },
  {
   "i": 12,
   "who": "taeo",
   "type": "speech",
   "text": "THE REPORT DOESN'T NAME A WITNESS.",
   "panel_id": "P08",
   "y_top": 8044,
   "y_bottom": 8265,
   "segment": "003.webp",
   "seg_y": 2760
  },
  {
   "i": 13,
   "who": "offpanel:nib",
   "type": "speech",
   "text": "THEN NO WITNESS.",
   "panel_id": "P08",
   "y_top": 8136,
   "y_bottom": 8290,
   "segment": "003.webp",
   "seg_y": 2785
  },
  {
   "i": 14,
   "who": "nib",
   "type": "speech",
   "text": "IN THE TUNNEL GATE, I PRESSED THE WALL. LIKE AT YOUR STORE.",
   "panel_id": "P09",
   "y_top": 8678,
   "y_bottom": 8900,
   "segment": "004.webp",
   "seg_y": 332
  },
  {
   "i": 15,
   "who": "taeo",
   "type": "speech",
   "text": "I DIDN'T FEEL THE PRESSURE.",
   "panel_id": "P09",
   "y_top": 8771,
   "y_bottom": 8993,
   "segment": "004.webp",
   "seg_y": 425
  },
  {
   "i": 16,
   "who": "nib",
   "type": "speech",
   "text": "THEN FIND OUT WHY.",
   "panel_id": "P09",
   "y_top": 9526,
   "y_bottom": 9680,
   "segment": "004.webp",
   "seg_y": 1112
  },
  {
   "i": 17,
   "who": "crew_man",
   "type": "shout",
   "text": "I SAID 'GO AROUND AND STOP'!",
   "panel_id": "P11",
   "y_top": 10912,
   "y_bottom": 11236,
   "segment": "005.webp",
   "seg_y": 434
  },
  {
   "i": 18,
   "who": "taeo",
   "type": "speech",
   "text": "SORRY. ONE COMMAND AT A TIME. JUST SAY 'STOP.'",
   "panel_id": "P11",
   "y_top": 11254,
   "y_bottom": 11544,
   "segment": "005.webp",
   "seg_y": 742
  },
  {
   "i": 19,
   "who": "crew_man",
   "type": "speech",
   "text": "STOP.",
   "panel_id": "P11",
   "y_top": 12096,
   "y_bottom": 12182,
   "segment": "005.webp",
   "seg_y": 1380
  },
  {
   "i": 20,
   "who": "haein",
   "type": "speech",
   "text": "YOU'VE BEEN WATCHING PARK DOYUN.",
   "panel_id": "P12",
   "y_top": 12314,
   "y_bottom": 12536,
   "segment": "005.webp",
   "seg_y": 1734
  },
  {
   "i": 21,
   "who": "taeo",
   "type": "speech",
   "text": "ALL TWELVE LECTURES.",
   "panel_id": "P12",
   "y_top": 12407,
   "y_bottom": 12561,
   "segment": "005.webp",
   "seg_y": 1759
  },
  {
   "i": 22,
   "who": "haein",
   "type": "speech",
   "text": "IT SHOWS. YOU LOOK TERRIBLE.",
   "panel_id": "P12",
   "y_top": 13094,
   "y_bottom": 13315,
   "segment": "005.webp",
   "seg_y": 2513
  },
  {
   "i": 23,
   "who": "taeo",
   "type": "speech",
   "text": "LECTURE FOUR. 'FOCUS YOUR ATTENTION ON ONE CONSTRUCT.'",
   "panel_id": "P13",
   "y_top": 13447,
   "y_bottom": 13669,
   "segment": "006.webp",
   "seg_y": 283
  },
  {
   "i": 24,
   "who": "nib",
   "type": "speech",
   "text": "I'M NOT IN LECTURE FOUR.",
   "panel_id": "P13",
   "y_top": 13687,
   "y_bottom": 13841,
   "segment": "006.webp",
   "seg_y": 455
  },
  {
   "i": 25,
   "who": "taeo",
   "type": "speech",
   "text": "MY PALM'S AMBER PULSE WENT DARK WHEN NIB CROSSED THE TUNNEL GATE.",
   "panel_id": "P14",
   "y_top": 14496,
   "y_bottom": 14786,
   "segment": "006.webp",
   "seg_y": 1400
  },
  {
   "i": 26,
   "who": "haein",
   "type": "speech",
   "text": "DID THE LIGHT STOP AT ONCE, OR FADE?",
   "panel_id": "P14",
   "y_top": 14804,
   "y_bottom": 15025,
   "segment": "006.webp",
   "seg_y": 1639
  },
  {
   "i": 27,
   "who": "taeo",
   "type": "speech",
   "text": "I WAS TOO SCARED TO NOTICE.",
   "panel_id": "P14",
   "y_top": 15534,
   "y_bottom": 15756,
   "segment": "006.webp",
   "seg_y": 2370
  },
  {
   "i": 28,
   "who": "haein",
   "type": "speech",
   "text": "THEN WE MEASURE THE PULSE.",
   "panel_id": "P15",
   "y_top": 15888,
   "y_bottom": 16110,
   "segment": "006.webp",
   "seg_y": 2724
  },
  {
   "i": 29,
   "who": "minho",
   "type": "speech",
   "text": "NO. NOT A C-GRADE AT THAT RATE. NO.",
   "panel_id": "P16",
   "y_top": 16474,
   "y_bottom": 16628,
   "segment": "007.webp",
   "seg_y": 264
  },
  {
   "i": 30,
   "who": "haein",
   "type": "speech",
   "text": "WE NEED THE TRAINING GATE.",
   "panel_id": "P16",
   "y_top": 16646,
   "y_bottom": 16800,
   "segment": "007.webp",
   "seg_y": 436
  },
  {
   "i": 31,
   "who": "minho",
   "type": "speech",
   "text": "RADIOS TELL ME WHERE MY SCOUT IS.",
   "panel_id": "P17",
   "y_top": 17496,
   "y_bottom": 17786,
   "segment": "008.webp",
   "seg_y": 374
  },
  {
   "i": 32,
   "who": "minho",
   "type": "speech",
   "text": "THEY DON'T TELL ME WHEN HIS SUPPORT BEAM IS SLIPPING.",
   "panel_id": "P17",
   "y_top": 17808,
   "y_bottom": 18230,
   "segment": "008.webp",
   "seg_y": 818
  },
  {
   "i": 33,
   "who": "minho",
   "type": "speech",
   "text": "ONE HOUR. THE ACADEMY PAYS TO RENT THIS GATE.",
   "panel_id": "P17",
   "y_top": 18252,
   "y_bottom": 18675,
   "segment": "008.webp",
   "seg_y": 1263
  },
  {
   "i": 34,
   "who": "haein",
   "type": "speech",
   "text": "THE SMALLEST GATE IN MAPO. TRAINING LICENCE.",
   "panel_id": "P18",
   "y_top": 19081,
   "y_bottom": 19302,
   "segment": "008.webp",
   "seg_y": 1890
  },
  {
   "i": 35,
   "who": "nib",
   "type": "speech",
   "text": "IT'S A GOOD SIZE.",
   "panel_id": "P18",
   "y_top": 19320,
   "y_bottom": 19474,
   "segment": "008.webp",
   "seg_y": 2062
  },
  {
   "i": 36,
   "who": "minho",
   "type": "speech",
   "text": "ONE RULE. NOBODY STEPS ON THE BOSS.",
   "panel_id": "P19",
   "y_top": 20249,
   "y_bottom": 20403,
   "segment": "009.webp",
   "seg_y": 264
  },
  {
   "i": 37,
   "who": "taeo",
   "type": "nervous",
   "text": "THIS GATE HAS A BOSS?",
   "panel_id": "P19",
   "y_top": 20421,
   "y_bottom": 20571,
   "segment": "009.webp",
   "seg_y": 432
  },
  {
   "i": 38,
   "who": "haein",
   "type": "speech",
   "text": "A SNAIL. IF IT DIES, THE GATE CLOSES AND WE LOSE THE LICENCE.",
   "panel_id": "P19",
   "y_top": 21106,
   "y_bottom": 21328,
   "segment": "009.webp",
   "seg_y": 1189
  },
  {
   "i": 39,
   "who": "haein",
   "type": "speech",
   "text": "THREE IDENTICAL BEAMS HOLD UP THE SANDBAGS. NIB WILL REMOVE ONE BEAM'S PIN.",
   "panel_id": "P20",
   "y_top": 21460,
   "y_bottom": 21817,
   "segment": "009.webp",
   "seg_y": 1678
  },
  {
   "i": 40,
   "who": "haein",
   "type": "speech",
   "text": "NIB CHOOSES WHICH BEAM. THEN HE LEANS ON ALL THREE, LEFT TO RIGHT.",
   "panel_id": "P20",
   "y_top": 21835,
   "y_bottom": 22057,
   "segment": "009.webp",
   "seg_y": 1918
  },
  {
   "i": 41,
   "who": "haein",
   "type": "speech",
   "text": "THREE TESTS. YOU SIT BEHIND THIS LINE, BLINDFOLDED, AND TELL ME WHICH BEAM SLIPS.",
   "panel_id": "P20",
   "y_top": 22561,
   "y_bottom": 22849,
   "segment": "009.webp",
   "seg_y": 2710
  },
  {
   "i": 42,
   "who": "taeo",
   "type": "nervous",
   "text": "IS THIS A SOCK?",
   "panel_id": "P21",
   "y_top": 23071,
   "y_bottom": 23221,
   "segment": "010.webp",
   "seg_y": 266
  },
  {
   "i": 43,
   "who": "haein",
   "type": "speech",
   "text": "IT'S CLEAN.",
   "panel_id": "P21",
   "y_top": 23243,
   "y_bottom": 23331,
   "segment": "010.webp",
   "seg_y": 376
  },
  {
   "i": 44,
   "who": "haein",
   "type": "speech",
   "text": "MOSTLY.",
   "panel_id": "P21",
   "y_top": 23353,
   "y_bottom": 23439,
   "segment": "010.webp",
   "seg_y": 484
  },
  {
   "i": 45,
   "who": "nib",
   "type": "speech",
   "text": "DON'T GUESS.",
   "panel_id": "P22",
   "y_top": 23665,
   "y_bottom": 23820,
   "segment": "010.webp",
   "seg_y": 865
  },
  {
   "i": 46,
   "who": "nib",
   "type": "speech",
   "text": "IF YOU FEEL NOTHING, SAY NOTHING.",
   "panel_id": "P22",
   "y_top": 23838,
   "y_bottom": 24060,
   "segment": "010.webp",
   "seg_y": 1105
  },
  {
   "i": 47,
   "who": "taeo",
   "type": "speech",
   "text": "OKAY.",
   "panel_id": "P22",
   "y_top": 24617,
   "y_bottom": 24703,
   "segment": "010.webp",
   "seg_y": 1748
  },
  {
   "i": 48,
   "who": "haein",
   "type": "speech",
   "text": "RUN ONE.",
   "panel_id": "P23",
   "y_top": 24835,
   "y_bottom": 24922,
   "segment": "011.webp",
   "seg_y": 151
  },
  {
   "i": 49,
   "who": "taeo",
   "type": "float",
   "text": "ONE BEAM AT A TIME. HOLD THE LINK.",
   "panel_id": "P26",
   "y_top": 27786,
   "y_bottom": 27873,
   "segment": "012.webp",
   "seg_y": 861
  },
  {
   "i": 50,
   "who": "offpanel:taeo",
   "type": "whisper",
   "text": "BEAM ONE HOLDS.",
   "panel_id": "P26",
   "y_top": 27891,
   "y_bottom": 28024,
   "segment": "012.webp",
   "seg_y": 1012
  },
  {
   "i": 51,
   "who": "offpanel:taeo",
   "type": "speech",
   "text": "BEAM TWO IS MOVING.",
   "panel_id": "P28",
   "y_top": 29059,
   "y_bottom": 29212,
   "segment": "012.webp",
   "seg_y": 2200
  },
  {
   "i": 52,
   "who": "haein",
   "type": "speech",
   "text": "NIB'S HOLDING UP TWO FINGERS. YOU CALLED BEAM TWO.",
   "panel_id": "P29",
   "y_top": 29600,
   "y_bottom": 29822,
   "segment": "013.webp",
   "seg_y": 332
  },
  {
   "i": 53,
   "who": "haein",
   "type": "speech",
   "text": "THAT'S A HIT.",
   "panel_id": "P29",
   "y_top": 29840,
   "y_bottom": 29994,
   "segment": "013.webp",
   "seg_y": 504
  },
  {
   "i": 54,
   "who": "offpanel:haein",
   "type": "speech",
   "text": "RUN TWO.",
   "panel_id": "P30",
   "y_top": 31012,
   "y_bottom": 31098,
   "segment": "013.webp",
   "seg_y": 1608
  },
  {
   "i": 55,
   "who": "taeo",
   "type": "float",
   "text": "NOTHING.",
   "panel_id": "P30",
   "y_top": 31116,
   "y_bottom": 31166,
   "segment": "013.webp",
   "seg_y": 1676
  },
  {
   "i": 56,
   "who": "offpanel:haein",
   "type": "speech",
   "text": "CALL IT.",
   "panel_id": "P31",
   "y_top": 31803,
   "y_bottom": 31889,
   "segment": "013.webp",
   "seg_y": 2399
  },
  {
   "i": 57,
   "who": "taeo",
   "type": "nervous",
   "text": "TWO?",
   "panel_id": "P31",
   "y_top": 31911,
   "y_bottom": 31995,
   "segment": "013.webp",
   "seg_y": 2505
  },
  {
   "i": 58,
   "who": "haein",
   "type": "speech",
   "text": "NIB'S HOLDING UP ONE FINGER. YOU MISSED.",
   "panel_id": "P32",
   "y_top": 32309,
   "y_bottom": 32530,
   "segment": "014.webp",
   "seg_y": 331
  },
  {
   "i": 59,
   "who": "nib",
   "type": "speech",
   "text": "THAT WAS A GUESS.",
   "panel_id": "P32",
   "y_top": 32401,
   "y_bottom": 32555,
   "segment": "014.webp",
   "seg_y": 356
  },
  {
   "i": 60,
   "who": "taeo",
   "type": "nervous",
   "text": "SORRY.",
   "panel_id": "P32",
   "y_top": 33137,
   "y_bottom": 33222,
   "segment": "014.webp",
   "seg_y": 1023
  },
  {
   "i": 61,
   "who": "haein",
   "type": "speech",
   "text": "DON'T APOLOGISE TO THE DATA.",
   "panel_id": "P33",
   "y_top": 33429,
   "y_bottom": 33718,
   "segment": "014.webp",
   "seg_y": 1519
  },
  {
   "i": 62,
   "who": "nib",
   "type": "speech",
   "text": "AGAIN.",
   "panel_id": "P33",
   "y_top": 33740,
   "y_bottom": 33826,
   "segment": "014.webp",
   "seg_y": 1627
  },
  {
   "i": 63,
   "who": "offpanel:haein",
   "type": "speech",
   "text": "RUN THREE.",
   "panel_id": "P34",
   "y_top": 34334,
   "y_bottom": 34424,
   "segment": "014.webp",
   "seg_y": 2225
  },
  {
   "i": 64,
   "who": "taeo",
   "type": "float",
   "text": "DON'T GUESS.",
   "panel_id": "P34",
   "y_top": 34442,
   "y_bottom": 34492,
   "segment": "014.webp",
   "seg_y": 2293
  },
  {
   "i": 65,
   "who": "offpanel:taeo",
   "type": "whisper",
   "text": "BEAM ONE HOLDS. BEAM TWO HOLDS.",
   "panel_id": "P35",
   "y_top": 35285,
   "y_bottom": 35474,
   "segment": "015.webp",
   "seg_y": 299
  },
  {
   "i": 66,
   "who": "taeo",
   "type": "shout",
   "text": "BEAM THREE! NIB!",
   "panel_id": "P39",
   "y_top": 39030,
   "y_bottom": 39264,
   "segment": "016.webp",
   "seg_y": 893
  },
  {
   "i": 67,
   "who": "minho",
   "type": "speech",
   "text": "STOP.",
   "panel_id": "P40",
   "y_top": 39957,
   "y_bottom": 40044,
   "segment": "016.webp",
   "seg_y": 1673
  },
  {
   "i": 68,
   "who": "minho",
   "type": "speech",
   "text": "YOU'RE AT THE RIM.",
   "panel_id": "P40",
   "y_top": 40062,
   "y_bottom": 40216,
   "segment": "016.webp",
   "seg_y": 1845
  },
  {
   "i": 69,
   "who": "nib",
   "type": "speech",
   "text": "THREE.",
   "panel_id": "P42",
   "y_top": 41651,
   "y_bottom": 41737,
   "segment": "017.webp",
   "seg_y": 196
  },
  {
   "i": 70,
   "who": "taeo",
   "type": "speech",
   "text": "TWO RIGHT OUT OF THREE TESTS.",
   "panel_id": "P43",
   "y_top": 43122,
   "y_bottom": 43277,
   "segment": "017.webp",
   "seg_y": 1736
  },
  {
   "i": 71,
   "who": "haein",
   "type": "speech",
   "text": "YOUR NOSE IS BLEEDING.",
   "panel_id": "P44",
   "y_top": 43409,
   "y_bottom": 43630,
   "segment": "017.webp",
   "seg_y": 2089
  },
  {
   "i": 72,
   "who": "nib",
   "type": "speech",
   "text": "GOOD ANSWER.",
   "panel_id": "P46",
   "y_top": 44328,
   "y_bottom": 44482,
   "segment": "018.webp",
   "seg_y": 264
  },
  {
   "i": 73,
   "who": "haein",
   "type": "speech",
   "text": "THREE RUNS. TWO HITS. ONE NOSEBLEED.",
   "panel_id": "P46",
   "y_top": 44392,
   "y_bottom": 44613,
   "segment": "018.webp",
   "seg_y": 395
  },
  {
   "i": 74,
   "who": "taeo",
   "type": "speech",
   "text": "I FEEL NIB'S PRESSURE THROUGH THE GATE. ONLY A FEW SECONDS AT A TIME.",
   "panel_id": "P46",
   "y_top": 45117,
   "y_bottom": 45406,
   "segment": "018.webp",
   "seg_y": 1188
  },
  {
   "i": 75,
   "who": "minho",
   "type": "speech",
   "text": "DID THE SNAIL SURVIVE?",
   "panel_id": "P47",
   "y_top": 45512,
   "y_bottom": 45734,
   "segment": "018.webp",
   "seg_y": 1516
  },
  {
   "i": 76,
   "who": "nib",
   "type": "speech",
   "text": "ALIVE.",
   "panel_id": "P47",
   "y_top": 45756,
   "y_bottom": 45842,
   "segment": "018.webp",
   "seg_y": 1624
  },
  {
   "i": 77,
   "who": "minho",
   "type": "speech",
   "text": "THAT NEW WHITE HAIR IS YOURS, TAEO.",
   "panel_id": "P47",
   "y_top": 45864,
   "y_bottom": 46219,
   "segment": "018.webp",
   "seg_y": 2001
  },
  {
   "i": 78,
   "who": "repo_man",
   "type": "speech",
   "text": "BLUEBIRD IS REPOSSESSING ONE OF YOUR THREE VANS. NOTHING PERSONAL.",
   "panel_id": "P49",
   "y_top": 47429,
   "y_bottom": 47718,
   "segment": "019.webp",
   "seg_y": 399
  },
  {
   "i": 79,
   "who": "repo_man",
   "type": "speech",
   "text": "THE ₩220,000 TOWING FEE GOES ON YOUR DEBT.",
   "panel_id": "P49",
   "y_top": 47736,
   "y_bottom": 47957,
   "segment": "019.webp",
   "seg_y": 638
  },
  {
   "i": 80,
   "who": "minho",
   "type": "speech",
   "text": "THE KEYS ARE IN THE VAN.",
   "panel_id": "P49",
   "y_top": 48466,
   "y_bottom": 48688,
   "segment": "019.webp",
   "seg_y": 1369
  },
  {
   "i": 81,
   "who": "haein",
   "type": "speech",
   "text": "DAD'S NOTEBOOKS. THEY DON'T GET THOSE.",
   "panel_id": "P50",
   "y_top": 48986,
   "y_bottom": 49275,
   "segment": "019.webp",
   "seg_y": 1956
  },
  {
   "i": 82,
   "who": "haein",
   "type": "speech",
   "text": "IT WAS DAD'S FIRST VAN.",
   "panel_id": "P51",
   "y_top": 49541,
   "y_bottom": 49694,
   "segment": "019.webp",
   "seg_y": 2375
  },
  {
   "i": 83,
   "who": "offpanel:minho",
   "type": "speech",
   "text": "BLUEBIRD CAN TAKE THE VAN. WE OWE THEM.",
   "panel_id": "P51",
   "y_top": 49605,
   "y_bottom": 49826,
   "segment": "019.webp",
   "seg_y": 2507
  },
  {
   "i": 84,
   "who": "haein",
   "type": "speech",
   "text": "YOU SAID NO TO GURO.",
   "panel_id": "P54",
   "y_top": 52041,
   "y_bottom": 52263,
   "segment": "020.webp",
   "seg_y": 1765
  },
  {
   "i": 85,
   "who": "minho",
   "type": "speech",
   "text": "THAT WAS THIS MORNING.",
   "panel_id": "P54",
   "y_top": 52281,
   "y_bottom": 52502,
   "segment": "020.webp",
   "seg_y": 2004
  },
  {
   "i": 86,
   "who": "minho",
   "type": "speech",
   "text": "THURSDAY.",
   "panel_id": "P55",
   "y_top": 53200,
   "y_bottom": 53287,
   "segment": "021.webp",
   "seg_y": 197
  },
  {
   "i": 87,
   "who": "minho",
   "type": "speech",
   "text": "A C-GRADE IN A GURO CONSTRUCTION PIT.",
   "panel_id": "P55",
   "y_top": 53305,
   "y_bottom": 53481,
   "segment": "021.webp",
   "seg_y": 391
  },
  {
   "i": 88,
   "who": "offpanel:minho",
   "type": "speech",
   "text": "PORTERS FROM DOKGO CONTRACTING.",
   "panel_id": "P56",
   "y_top": 54169,
   "y_bottom": 54457,
   "segment": "021.webp",
   "seg_y": 1367
  },
  {
   "i": 89,
   "who": "taeo",
   "type": "speech",
   "text": "THE COMPANY FROM THE MISSING PORTER STORY?",
   "panel_id": "P56",
   "y_top": 54479,
   "y_bottom": 54902,
   "segment": "021.webp",
   "seg_y": 1812
  },
  {
   "i": 90,
   "who": "minho",
   "type": "speech",
   "text": "I KNOW WHICH COMPANY.",
   "panel_id": "P57",
   "y_top": 55175,
   "y_bottom": 55397,
   "segment": "021.webp",
   "seg_y": 2307
  },
  {
   "i": 91,
   "who": "minho",
   "type": "speech",
   "text": "NIB. YOU'D SCOUT OUR SURVEY LINE, IF YOU WANT THE JOB.",
   "panel_id": "P58",
   "y_top": 55696,
   "y_bottom": 55918,
   "segment": "022.webp",
   "seg_y": 332
  },
  {
   "i": 92,
   "who": "nib",
   "type": "speech",
   "text": "I'M IN.",
   "panel_id": "P58",
   "y_top": 55789,
   "y_bottom": 55875,
   "segment": "022.webp",
   "seg_y": 289
  },
  {
   "i": 93,
   "who": "minho",
   "type": "speech",
   "text": "TAEO. YOU STAY OUTSIDE.",
   "panel_id": "P58",
   "y_top": 56427,
   "y_bottom": 56648,
   "segment": "022.webp",
   "seg_y": 1062
  },
  {
   "i": 94,
   "who": "taeo",
   "type": "speech",
   "text": "I ALWAYS STAY OUTSIDE.",
   "panel_id": "P59",
   "y_top": 56944,
   "y_bottom": 57165,
   "segment": "022.webp",
   "seg_y": 1579
  },
  {
   "i": 95,
   "who": "minho",
   "type": "speech",
   "text": "YOU **STAY** OUTSIDE.",
   "panel_id": "P61",
   "y_top": 57881,
   "y_bottom": 58036,
   "segment": "023.webp",
   "seg_y": 265
  }
 ],
